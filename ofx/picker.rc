#include <windows.h>
101 DIALOGEX 0, 0, 290, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose Composition"
FONT 9, "Segoe UI"
