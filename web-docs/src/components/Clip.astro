---
// A short looping recording, shown the way a picture is: no controls, no
// sound, playing by itself. The still is the clip's first frame, so a reader
// with reduced motion sees the picture and nothing moves.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const clips = import.meta.glob<{ default: string }>('/src/assets/clips/*.mp4', {
  eager: true,
  query: '?url',
});
const stills = import.meta.glob<{ default: ImageMetadata }>('/src/assets/clips/*.png', {
  eager: true,
});

interface Props {
  /** Name inside src/assets/clips/, without the extension. Needs name.mp4 and name.png. */
  name: string;
  /** Sentence under the clip. Also its label for screen readers. */
  caption: string;
}

const { name, caption } = Astro.props;
const clip = clips[`/src/assets/clips/${name}.mp4`];
const still = stills[`/src/assets/clips/${name}.png`];
const poster = still ? await getImage({ src: still.default, format: 'webp' }) : undefined;
---

{
  clip && still ? (
    <figure class="clip">
      <video
        src={clip.default}
        poster={poster?.src}
        width={still.default.width}
        height={still.default.height}
        aria-label={caption}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        disablepictureinpicture
      />
      <figcaption>{caption}</figcaption>
    </figure>
  ) : (
    <figure class="clip clip--wanted" aria-hidden="true">
      <div class="clip__box">
        <span class="clip__label">Clip wanted</span>
        <code class="clip__file">{name}.mp4</code>
      </div>
      <figcaption>{caption}</figcaption>
    </figure>
  )
}

<script>
  // Reduced motion: stop on the first frame. Off screen: pause, so a page of
  // clips is not decoding all of them at once.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const seen = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting && !still.matches) v.play().catch(() => {});
      else v.pause();
    }
  });
  document.querySelectorAll<HTMLVideoElement>('.clip video').forEach((v) => {
    if (still.matches) {
      v.removeAttribute('autoplay');
      v.pause();
    }
    seen.observe(v);
  });
</script>

<style>
  .clip {
    margin: 1.5rem 0;
  }
  .clip video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--lm-radius-card);
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-inline-code);
  }
  .clip figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
  }
  .clip__box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 9rem;
    padding: 1.5rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: var(--lm-radius-card);
    background: var(--sl-color-bg-inline-code);
  }
  .clip__label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-4);
  }
  .clip__file {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
  }
</style>
