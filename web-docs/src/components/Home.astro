---
// The manual's front page: a search field, then every page in it. The list is
// laid out from the sidebar itself (src/fullSidebar.ts), so a page added to
// astro.config.mjs turns up here without being written down twice.
//
// A group takes one of three shapes. Four pages or fewer are cards, each with
// its description. More than that are tiles. A group of groups is a row of
// columns, unless the inner groups are closed in the sidebar, as the effect
// categories are, and then each is a tile with a count.
import { getCollection } from "astro:content";
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type Entries = StarlightRouteData["sidebar"];
type Group = Extract<Entries[number], { type: "group" }>;
type Link = Extract<Entries[number], { type: "link" }>;

const { topics } = Astro.locals.starlightSidebarTopics;
const blurbs = new Map(
  (await getCollection("docs")).map((page) => [`/${page.id}/`, page.data.description]),
);

const groupsOf = (entries: Entries) => entries.filter((e): e is Group => e.type === "group");
const linksOf = (entries: Entries) => entries.filter((e): e is Link => e.type === "link");
const count = (entries: Entries): number =>
  entries.reduce((n, e) => n + (e.type === "link" ? 1 : count(e.entries)), 0);
const two = (n: number) => String(n).padStart(2, "0");
// The id Markdown gives a heading, for the plain labels a sidebar group has.
const anchor = (label: string) =>
  label.toLowerCase().replace(/[^\w\s-]/g, "").replace(/\s/g, "-");

// A card or tile wears a layer's label colour, taken in turn.
const labels = ["azure", "amber", "violet", "mint", "teal", "indigo", "magenta", "coral"];
const colour = (i: number) => `--c:var(--label-${labels[i % labels.length]})`;

// ponytail: a page put straight under a topic, outside any group, is not
// listed. Every page is in a group today.
const sections = groupsOf(Astro.locals.fullSidebar).map((topic, t) => ({
  label: topics[t]?.label,
  groups: groupsOf(topic.entries).map((group) => {
    const links = linksOf(group.entries);
    const inner = groupsOf(group.entries);
    const cards = inner.length === 0 && links.length <= 4;
    // A closed group has no page of its own. The group's first page is its
    // index, which has a heading for each of them.
    const index = links[0]?.href;
    return {
      label: group.label,
      cards: cards ? links : [],
      columns: inner.filter((g) => !g.collapsed),
      tiles: [
        ...(cards ? [] : links.map((l) => ({ label: l.label, href: l.href, note: "" }))),
        ...inner
          .filter((g) => g.collapsed)
          .map((g) => ({
            label: g.label,
            href: index ? `${index}#${anchor(g.label)}` : linksOf(g.entries)[0]?.href,
            note: String(count(g.entries)),
          })),
      ],
    };
  }),
}));
---

<div class="docs-home not-content">
  <div class="home-top">
    <p class="lede"><slot /></p>
    {/* Opens the search the bar has, which is an icon on a phone. */}
    <button class="home-search" type="button" data-home-search>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="7" cy="7" r="4.5"></circle>
        <path d="M10.5 10.5 14 14"></path>
      </svg>
      Search the docs
    </button>
  </div>

  {
    sections.map((section, s) => (
      <section>
        <div class="sec-rule">
          <p class="kicker">{section.label}</p>
          <span class="sec-no">
            {two(s + 1)} / {two(sections.length)}
          </span>
        </div>
        {section.groups.map((group) => (
          <div class="home-group">
            <h2>{group.label}</h2>
            {group.cards.length > 0 && (
              <div class="home-cards">
                {group.cards.map((link, i) => (
                  <a class="home-card lit" href={link.href} style={colour(i)}>
                    <span class="home-tag">
                      <i class="home-key" />
                      {two(i + 1)}
                    </span>
                    <strong>{link.label}</strong>
                    {blurbs.get(link.href)}
                  </a>
                ))}
              </div>
            )}
            {group.tiles.length > 0 && (
              <div class="home-tiles">
                {group.tiles.map((tile, i) => (
                  <a class="home-tile lit" href={tile.href} style={colour(i)}>
                    {tile.label}
                    {tile.note && <small>{tile.note}</small>}
                  </a>
                ))}
              </div>
            )}
            {group.columns.length > 0 && (
              <div class="home-cols">
                {group.columns.map((column) => (
                  <div class="home-col">
                    <p class="kicker">{column.label}</p>
                    {linksOf(column.entries).map((link) => (
                      <a href={link.href}>{link.label}</a>
                    ))}
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </section>
    ))
  }
</div>

<script>
  document.querySelector("[data-home-search]")?.addEventListener("click", (event) => {
    // Starlight closes its search on any click outside it that reaches the
    // window, and this one would.
    event.stopPropagation();
    document.querySelector<HTMLButtonElement>("site-search button[data-open-modal]")?.click();
  });
</script>

<style>
  /* The page has no "On this page" rail, so the list takes the room. */
  :global(:root:has(.docs-home)) {
    --sl-content-width: 62rem;
  }
  .docs-home,
  section {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }
  .docs-home {
    gap: 4rem;
  }
  .home-top,
  .home-group {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }
  .home-top {
    gap: 1.75rem;
  }
  .lede {
    font-size: 1.0625rem;
  }
  .home-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 38.75rem;
    height: 3rem;
    padding: 0 1rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--lm-radius-ctl);
    background: rgb(255 255 255 / 0.03);
    color: var(--sl-color-gray-3);
    font: inherit;
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .home-search:hover {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
  }
  h2 {
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
  }
  a {
    text-decoration: none;
  }

  .home-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(13.5rem, 100%), 1fr));
    gap: 0.75rem;
  }
  .home-card,
  .home-tile {
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--lm-radius-card);
    background: var(--lm-surface-1);
    transition: border-color 0.15s;
  }
  .home-card:hover,
  .home-tile:hover {
    border-color: var(--sl-color-hairline-light);
  }
  .home-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.125rem 1.25rem 1.375rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--sl-color-gray-3);
  }
  .home-card strong {
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  .home-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-family: var(--sl-font-mono);
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.1em;
    color: var(--sl-color-gray-3);
  }
  /* A keyframe, in the card's colour. */
  .home-key {
    width: 7px;
    height: 7px;
    background: var(--c);
    transform: rotate(45deg);
  }

  .home-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(10rem, 100%), 1fr));
    gap: 0.5rem;
  }
  .home-tile {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .home-tile small {
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    color: var(--sl-color-gray-4);
  }

  .home-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(10rem, 100%), 1fr));
    gap: 2rem 1.5rem;
  }
  .home-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--sl-color-hairline);
  }
  .home-col .kicker {
    margin-bottom: 0.375rem;
    color: var(--sl-color-gray-4);
  }
  .home-col a {
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--sl-color-gray-2);
    transition: color 0.15s;
  }
  .home-col a:hover {
    color: var(--sl-color-white);
  }
</style>
