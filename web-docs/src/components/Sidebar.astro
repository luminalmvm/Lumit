---
// The sidebar, with every topic's list on the page at once (src/fullSidebar.ts).
// A tab swaps the list under it and leaves the page alone, so only a link in a
// list goes anywhere. Without script a tab is still a link to its topic.
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";
import Topics from "starlight-sidebar-topics/components/Sidebar.astro";
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";

const { topics } = Astro.locals.starlightSidebarTopics;
const lists = Astro.locals.fullSidebar.filter((entry) => entry.type === "group");

// The Guides list keeps its two top groups open and closes the groups inside
// them. Done here, not with `collapsed` in astro.config.mjs, because the home
// page reads that flag to lay a group out as tiles. A group that holds the
// current page still opens itself.
type Entries = typeof lists;
const closeInner = (entries: Entries): Entries =>
  entries.map((top) =>
    top.type === "group"
      ? {
          ...top,
          entries: top.entries.map((e) => (e.type === "group" ? { ...e, collapsed: true } : e)),
        }
      : top,
  );
---

<Topics />
<SidebarPersister>
  {
    lists.map((list, i) => (
      <div data-topic-list hidden={!topics[i]?.isCurrent}>
        <SidebarSublist sublist={topics[i]?.label === "Guides" ? closeInner(list.entries) : list.entries} />
      </div>
    ))
  }
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<script>
  const tabs = [...document.querySelectorAll(".starlight-sidebar-topics a")];
  const lists = [...document.querySelectorAll<HTMLElement>("[data-topic-list]")];
  tabs.forEach((tab, i) =>
    tab.addEventListener("click", (event) => {
      // Asking for a new tab or window still gets the topic's own page.
      if (!(event instanceof MouseEvent) || event.ctrlKey || event.metaKey || event.shiftKey) return;
      event.preventDefault();
      tabs.forEach((other, j) => {
        other.classList.toggle("starlight-sidebar-topics-current", i === j);
        other.toggleAttribute("aria-current", i === j);
      });
      lists.forEach((list, j) => (list.hidden = i !== j));
    }),
  );
</script>
