---
// The sidebar, with every topic's list on the page at once (src/fullSidebar.ts).
// A tab swaps the list under it and leaves the page alone, so only a link in a
// list goes anywhere. Without script a tab is still a link to its topic.
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";
import Topics from "starlight-sidebar-topics/components/Sidebar.astro";
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";

const { topics } = Astro.locals.starlightSidebarTopics;
const lists = Astro.locals.fullSidebar.filter((entry) => entry.type === "group");
---

<Topics />
<SidebarPersister>
  {
    lists.map((list, i) => (
      <div data-topic-list hidden={!topics[i]?.isCurrent}>
        <SidebarSublist sublist={list.entries} />
      </div>
    ))
  }
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<script>
  const tabs = [...document.querySelectorAll(".starlight-sidebar-topics a")];
  const lists = [...document.querySelectorAll<HTMLElement>("[data-topic-list]")];
  tabs.forEach((tab, i) =>
    tab.addEventListener("click", (event) => {
      // Asking for a new tab or window still gets the topic's own page.
      if (!(event instanceof MouseEvent) || event.ctrlKey || event.metaKey || event.shiftKey) return;
      event.preventDefault();
      tabs.forEach((other, j) => {
        other.classList.toggle("starlight-sidebar-topics-current", i === j);
        other.toggleAttribute("aria-current", i === j);
      });
      lists.forEach((list, j) => (list.hidden = i !== j));
    }),
  );
</script>
