---
// An effect page's before-and-after figure. The markup below is what
// scripts/gen-effect-pages.mjs used to write inline on every page; it lives here
// so both pictures can go through astro:assets, which is what the dev toolbar's
// audit asks for. The figure is always the first thing on its page, so both
// pictures load eagerly rather than lazily.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const shots = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/effects/**/*.webp',
  { eager: true }
);

interface Props {
  /** The effect's label, as the manual writes it. */
  label: string;
  /** The effect's category slug, which is also its folder. */
  category: string;
  /** The effect's own slug, which is also its file name. */
  slug: string;
  /** The untouched frame, if it is ever anything but plate.webp. */
  plate?: string;
}

const { label, category, slug, plate = 'plate' } = Astro.props;
const before = shots[`/src/assets/effects/${plate}.webp`];
const after = shots[`/src/assets/effects/${category}/${slug}.webp`];
---

{
  before && after && (
    <figure class="example">
      <div class="compare" style="--split:50%">
        <Image
          src={before.default}
          alt={`The frame before ${label} is applied`}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
        <Image
          class="compare__after"
          src={after.default}
          alt={`The same frame with ${label} applied`}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
        <span class="compare__handle" aria-hidden="true" />
        <span class="compare__label compare__label--a" aria-hidden="true">Original</span>
        <span class="compare__label compare__label--b" aria-hidden="true">
          {label}
        </span>
        <input
          class="compare__range"
          type="range"
          min="0"
          max="100"
          step="0.1"
          value="50"
          aria-label={`Reveal ${label}. Left of the handle is the original frame, the right has the ${label} applied.`}
        />
      </div>
      <figcaption>
        Drag the handle. {label} applied on the right, the original frame on the left.
      </figcaption>
    </figure>
  )
}
