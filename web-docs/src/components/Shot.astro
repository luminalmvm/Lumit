---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const shots = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/shots/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);

interface Props {
  /** Filename inside src/assets/shots/ */
  file: string;
  /** Sentence under the image. Also the alt text if `alt` is absent. */
  caption: string;
  /** Alt text, when it should differ from the caption. */
  alt?: string;
  /** Set on the first screenshot of a page so it loads immediately. */
  eager?: boolean;
}

const { file, caption, alt, eager = false } = Astro.props;
const hit = shots[`/src/assets/shots/${file}`];
---

{
  hit ? (
    <figure class="shot">
      <Image
        src={hit.default}
        alt={alt ?? caption}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding={eager ? 'sync' : 'async'}
        densities={[1, 2]}
      />
      <figcaption>{caption}</figcaption>
    </figure>
  ) : (
    <figure class="shot shot--wanted" aria-hidden="true">
      <div class="shot__box">
        <span class="shot__label">Screenshot wanted</span>
        <code class="shot__file">{file}</code>
      </div>
      <figcaption>{caption}</figcaption>
    </figure>
  )
}

<style>
  .shot {
    margin: 1.5rem 0;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--sl-color-hairline);
  }
  .shot figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
  }
  .shot__box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 9rem;
    padding: 1.5rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 8px;
    background: var(--sl-color-bg-inline-code);
  }
  .shot__label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-4);
  }
  .shot__file {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
  }
</style>
