  "badgePluginMissing": "This plugin is not installed on this machine",
  "@badgePluginMissing": {
    "description": "Calm badge at the top of an effect's card in the Effect controls panel, for an OFX plugin effect in the project that this machine has no plugin for. The effect is kept exactly as it was saved and is not lost."
