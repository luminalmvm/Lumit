  },
  "settingsHelpTransformInEffectControls": "Repeat the layer's Transform rows above its effects. The Timeline already shows them when a layer is twirled open.",
  "@settingsHelpTransformInEffectControls": {
    "description": "Settings window: the sentence under the settingsTransformInEffectControls setting."
  },
  "settingsHelpShapeEasesInAPopup": "The graph editor's Easing button opens the shape editor in a small floating box instead of the Easing panel. The box closes whenever you click outside it — and choosing different keyframes is a click outside — so one drawn shape can only be tried on the selection that was live when it opened. Turn it on to save the screen space.",
  "@settingsHelpShapeEasesInAPopup": {
    "description": "Settings window: the sentence under the settingsShapeEasesInAPopup setting."
  },
  "settingsHelpUseThemeColours": "Off, a scope reads on the standard near-black graticule whatever the chrome — which is how a signal is measured. On, it takes the theme's colours instead.",
  "@settingsHelpUseThemeColours": {
    "description": "Settings window: the sentence under the settingsUseThemeColours setting."
  },
  "settingsHelpVideoArrivesAsASequence": "Video and image sequences added to a composition become a Sequence layer, which can be cut into clips on its own row. Still images are never wrapped.",
  "@settingsHelpVideoArrivesAsASequence": {
    "description": "Settings window: the sentence under the settingsVideoArrivesAsASequence setting."
  },
  "settingsHelpVramBudget": "How much video memory finished frames may hold, of the {total} on the card.",
  "@settingsHelpVramBudget": {
