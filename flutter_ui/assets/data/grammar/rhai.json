{
    "name": "Rhai",
    "scopeName": "source.rhai",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#function_calls"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.rhai",
                    "match": "//.*"
                },
                {
                    "name": "comment.block.rhai",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.rhai",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.rhai",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.interpolated.rhai",
                    "begin": "`",
                    "end": "`"
                },
                {
                    "name": "string.quoted.single.rhai",
                    "match": "'(\\\\.|[^'\\\\])'"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.rhai",
                    "match": "\\b(0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+)\\b"
                },
                {
                    "name": "constant.numeric.rhai",
                    "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9_]+)?\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.rhai",
                    "match": "\\b(if|else|switch|do|while|until|loop|for|in|break|continue|return|throw|try|catch)\\b"
                },
                {
                    "name": "storage.type.rhai",
                    "match": "\\b(let|const|fn|private|import|export|as|global)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.rhai",
                    "match": "\\b(true|false|this)\\b"
                }
            ]
        },
        "function_calls": {
            "patterns": [
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.rhai"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.rhai",
                    "match": "=>|\\.\\.=?|\\*\\*=?|==|!=|<=|>=|&&|\\|\\||[-+*/%]=?|[<>!=&|^]"
                }
            ]
        }
    }
}
