---
// The foot of every page: the mark and the line it stands for on the left,
// every destination on the site in three groups beside it. On a wide window a
// group is its name with its links in two columns to the right of it, so the
// whole foot is as deep as half the longest group.
const columns = [
  {
    h: "Lumit",
    links: [
      { href: "/download", label: "Download" },
      { href: "/releases", label: "Releases" },
      { href: "/releases/rss.xml", label: "Release feed" },
      { href: "/#roadmap", label: "Roadmap" },
      { href: "/media", label: "Media" },
    ],
  },
  {
    h: "Learn",
    links: [
      { href: "https://docs.lumitlab.com", label: "Docs" },
      { href: "https://docs.lumitlab.com/start/first-composition/", label: "First composition" },
      { href: "https://docs.lumitlab.com/effects/", label: "Effects" },
      { href: "/projects", label: "Projects" },
    ],
  },
  {
    h: "Take part",
    links: [
      { href: "https://github.com/luminalmvm/Lumit", label: "GitHub" },
      { href: "https://discord.gg/dc3p3XC7mM", label: "Discord" },
      { href: "/translate", label: "Translate" },
      { href: "/sponsor", label: "Sponsor" },
    ],
  },
];
---

<footer class="border-t border-line text-fg-3">
  <div class="wrap grid gap-x-10 gap-y-12 py-12 md:grid-cols-[minmax(0,1fr)_auto]">
    <div class="flex flex-col items-start gap-5">
      {/* The wordmark's file has room at its left for the mark to open into,
          so it is pulled back to stand on the column's edge. */}
      <a href="/" class="-ml-[15px] flex items-center no-underline">
        <img src="/lumit-wordmark.svg" alt="Lumit" height="22" class="block h-[22px] w-auto" />
      </a>
      <p class="max-w-[300px] text-[15px] leading-[1.45]">
        Let your creativity flow. Free and open-source, forever.
      </p>
    </div>
    <nav class="groups" aria-label="Site">
      {
        columns.map((c) => (
          <div class="group">
            <p class="kicker text-fg-4">{c.h}</p>
            <div class="links" style={`--rows:${Math.ceil(c.links.length / 2)}`}>
              {c.links.map((l) => (
                <a href={l.href} class="text-[15px] text-fg-2 no-underline transition-colors hover:text-fg">
                  {l.label}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, auto));
    align-content: start;
    align-items: start;
    gap: 40px 56px;
  }
  .group,
  .links {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .groups {
      grid-template-columns: repeat(3, auto);
    }
  }
  /* Wide enough for it: a group's name stands to the left of its links, and
     the links fill two columns downwards. The name is a line shorter than a
     link, so it is given a link's line to sit level with the first one. */
  @media (min-width: 1280px) {
    .groups {
      column-gap: 52px;
    }
    .group {
      flex-direction: row;
      gap: 20px;
    }
    .group .kicker {
      height: 22.5px;
    }
    .links {
      display: grid;
      grid-auto-flow: column;
      grid-template-rows: repeat(var(--rows), auto);
      align-content: start;
      gap: 12px 26px;
    }
  }
</style>
