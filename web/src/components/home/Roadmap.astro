---
import SectionHead from "../SectionHead.astro";

// Four stages. The next release is already built, so it is drawn as done. The
// last one is drawn dashed and hollow: past the near work the order is a guess
// and the site should say so. A done stage opens on its first SHOWN items, the
// biggest, and the rest are a click away.
const SHOWN = 12;

const roadmap = [
  {
    label: "Released",
    state: "done",
    count: "in 0.11.2",
    items: [
      "Multi-edit with friends",
      "Lumit in the browser",
      "Lumit for iPhone and Android",
      "Over 200 built-in effects",
      "3D models, 3D shapes, and extruded text",
      "3D layers, cameras, lights, and materials",
      "Particle simulation on the graphics card",
      "Node graph effects and compositions",
      "Colour workspace with grading and scopes",
      "Cut workspace with multicam and transitions",
      "Captions and editing by transcript",
      "Mixer with buses, sends, and automation",
      "Smoke, fire, and volumetric light",
      "After Effects, PSD, and Illustrator import",
      "OFX, CLAP, and VST3 plugin hosting",
      "Sequence layers and Retime",
      "Expressions and drivers",
      "Text layers and animators",
      "Shape layers, modifiers, and paint",
      "Layers, masks, mattes, and blend modes",
      "Keyframes and the Graph editor",
      "Roto brush and Puppet",
      "Camera and planar tracking",
      "Denoise and Stabilise",
      "Optical-flow frame interpolation",
      "Custom shaders, as code or a graph",
      "LFX, Lumit's own effect format",
      "Colour management with OpenColorIO",
      "Tone mapping in the Viewer",
      "Points effects and Depth points",
      "Graphics templates",
      "Presets and the Library",
      "Lottie import, Lottie and animated SVG export",
      "Audio workspace, Audio timeline, and effects",
      "Sound clean-up and voice isolation",
      "Beat detection and markers",
      "Scripting, the command line, and MCP",
      "Lumit Pro: previews, backup, and sync",
      "Export on another computer, with Lumit Pro",
      "Multiple Viewers, compare, and a video monitor",
      "Panels in their own windows",
      "Interface styles and colour themes",
      "Addons with local models",
      "Extensions",
      "Interpret footage",
      "Packed project files",
      "Setup screen and guided tour",
      "Export queue with hardware encoding",
      "Proxies and background caching",
      "Autosave and crash recovery",
      "Translations, with Arabic right to left",
      "Windows, macOS, and Linux builds",
    ],
  },
  {
    label: "Next release",
    state: "done",
    count: "built for 0.12",
    items: [
      "DaVinci Resolve link on Windows",
      "Reworked text animators, with new selectors",
      "Keyframes on a text layer's words",
      "Expressions beside keyframes, and on Retime",
      "Curved motion paths",
      "Outline, angle, and keyed gradients on shapes",
      "More procedural textures and noise types",
      "Holographic foil, Hologram, and Flicker effects",
      "Particle colour over life and sprite shapes",
      "Depth Anything V3 Small in the Depth effect",
      "Redesigned Settings window",
      "Shape fill and stroke on the toolbar",
    ],
  },
  {
    label: "In progress",
    state: "now",
    count: "under way",
    items: [
      "A more responsive interface, Viewer, and audio",
      "A picture that follows drags and scrubs",
      "Faster playback and export on heavy comps",
      "Lower memory use on heavy frames",
      "Fixes for bugs reported on Discord and GitHub",
      "More pictures in the manual's tutorials",
    ],
  },
  {
    label: "Later",
    state: "next",
    count: "planned",
    items: [
      "Bounce and elastic easing",
      "A Properties panel",
      "Graph editor tangent controls and handle modes",
      "A transform box for picked keys",
      "Animation presets",
      "Blender camera, null, and light import",
      "OpenTimelineIO interchange",
      "Exports split across many computers",
    ],
  },
];
---

<section id="roadmap" class="wrap flex scroll-mt-20 flex-col gap-12 pb-20 sm:pb-28">
  <SectionHead kicker="Roadmap" title="What is built, and what is next." no="06 / 07">
    <Fragment slot="lede">
      Lumit is in public beta. Later work has no dates, and its order may change.
    </Fragment>
  </SectionHead>

  {/* The roadmap as one layer bar: each stage as long as its list, and the
      playhead standing where the work is now. */}
  <div class="track" data-reveal aria-hidden="true">
    {
      roadmap.map((stage) => (
        <div class:list={["seg", `seg-${stage.state}`]} style={`flex:${stage.items.length}`}>
          <i />
          <span>
            <em>{stage.label}</em>
            <b>{stage.items.length}</b>
          </span>
        </div>
      ))
    }
  </div>

  <div class="flex flex-col gap-5">
    {
      roadmap.map((stage) => (
        <div class:list={["stage", `stage-${stage.state}`]} data-reveal>
          <div class="head">
            <h3 class="kicker">
              <i class:list={["key", stage.state === "next" && "key-hollow"]} />
              {stage.label}
              {stage.state === "now" && <span class="now">Now</span>}
            </h3>
            <p class="count">{stage.items.length} {stage.count}</p>
          </div>
          <div>
            <ul class="items">
              {stage.items.slice(0, stage.state === "done" ? SHOWN : undefined).map((item) => (
                <li>
                  <i class:list={["key", stage.state === "next" && "key-hollow"]} />
                  {item}
                </li>
              ))}
            </ul>
            {stage.state === "done" && stage.items.length > SHOWN && (
              <details class="more">
                <summary class="go">
                  <span class="closed">Show all {stage.items.length}</span>
                  <span class="opened">Show fewer</span>
                </summary>
                <ul class="items">
                  {stage.items.slice(SHOWN).map((item) => (
                    <li>
                      <i class="key" />
                      {item}
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Each stage has one colour: the accent for what is done, the amber of a
     keyed value for what is in hand, grey for what is only planned. */
  .seg-done,
  .stage-done {
    --k: var(--color-accent-2);
  }
  .seg-now,
  .stage-now {
    --k: var(--color-key);
  }
  .seg-next,
  .stage-next {
    --k: var(--color-fg-4);
  }

  .track {
    display: flex;
    gap: 3px;
  }
  .seg {
    position: relative;
    display: flex;
    /* A short stage still has room for its name. */
    min-width: max-content;
    flex-direction: column;
    gap: 10px;
  }
  .seg i {
    position: relative;
    height: 14px;
    overflow: hidden;
    border: 1px solid var(--k);
    border-radius: var(--radius-ctl);
    background: color-mix(in srgb, var(--k) 55%, var(--color-ink));
  }
  .seg-now i {
    box-shadow: 0 0 18px color-mix(in srgb, var(--k) 35%, transparent);
  }
  /* The work in hand is the part that moves. The stripes are a layer of their
     own, one stripe pair wider than the bar, and it is the layer that slides:
     a transform is moved by the compositor, where a background's position is
     painted again on every frame. 16.97 is one stripe pair along the bar, 12
     across the stripes at 45 degrees. */
  .seg-now i::before {
    content: "";
    position: absolute;
    inset: 0 0 0 -16.97px;
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--k) 70%, var(--color-ink)) 0 6px,
      color-mix(in srgb, var(--k) 35%, var(--color-ink)) 6px 12px
    );
  }
  @media (prefers-reduced-motion: no-preference) {
    .seg-now i::before {
      will-change: transform;
      animation: stripes 1.4s linear infinite;
    }
  }
  @keyframes stripes {
    to { transform: translateX(16.97px); }
  }
  .seg-next i {
    border-style: dashed;
    background: none;
  }
  /* The playhead, on the cut between done and now. */
  .seg-now::before {
    content: "";
    position: absolute;
    top: -8px;
    left: -2px;
    width: 1px;
    height: 30px;
    background: var(--color-fg);
  }
  .seg-now::after {
    content: "";
    position: absolute;
    top: -9px;
    left: -6.5px;
    border: 5px solid transparent;
    border-top: 7px solid var(--color-fg);
  }
  .seg span {
    display: flex;
    align-items: baseline;
    gap: 8px;
    overflow: hidden;
    padding-right: 12px;
    color: var(--color-fg-3);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .seg em {
    font-style: normal;
  }
  .seg b {
    color: var(--color-fg);
    font-weight: 400;
    font-feature-settings: "zero";
  }

  /* A stage is a card: its name and count on the left, its list in columns
     beside it. */
  .stage {
    display: grid;
    gap: 22px;
    padding: 26px 28px 28px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-ink-2);
  }
  .stage-now {
    border-color: color-mix(in srgb, var(--color-key) 40%, var(--color-line));
    background:
      radial-gradient(60% 120% at 0% 0%, color-mix(in srgb, var(--color-key) 9%, transparent), transparent 70%),
      var(--color-ink-2);
  }
  .stage-next {
    border-style: dashed;
    background: none;
  }
  .head .kicker {
    color: var(--color-fg);
  }
  .now {
    padding: 3px 6px;
    border: 1px solid color-mix(in srgb, var(--color-key) 50%, transparent);
    border-radius: var(--radius-ctl);
    color: var(--color-key);
    font-size: 10px;
  }
  .count {
    margin-top: 12px;
    color: var(--color-fg-4);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
  }
  .items {
    margin: 0;
    padding: 0;
    column-gap: 32px;
    list-style: none;
  }
  .items li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 6px 0;
    break-inside: avoid;
    color: var(--color-fg-2);
    font-size: 14.5px;
    line-height: 1.35;
  }
  .items .key {
    position: relative;
    top: -1px;
    width: 6px;
    height: 6px;
  }
  /* The rest of what is done, behind a button under the first few. */
  .more summary {
    width: fit-content;
    margin: 14px 0 6px;
    cursor: pointer;
    list-style: none;
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more summary::after {
    content: "\2193";
  }
  .more[open] summary::after {
    content: "\2191";
  }
  .more .opened,
  .more[open] .closed {
    display: none;
  }
  .more[open] .opened {
    display: inline;
  }
  .stage-next .items li {
    color: var(--color-fg-3);
  }
  @media (min-width: 640px) {
    .items {
      columns: 2;
    }
  }
  @media (min-width: 1024px) {
    .stage {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 40px;
    }
    .items {
      columns: 3;
    }
  }
  @media (max-width: 639px) {
    /* A phone has no room for a name under a bar a fifth of its width, so
       the bar keeps its counts and the cards below carry the names. */
    .seg em {
      display: none;
    }
  }
</style>
