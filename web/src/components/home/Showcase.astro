---
import { Image, getImage } from "astro:assets";
import SectionHead from "../SectionHead.astro";
import { releasesNewestFirst } from "../../scripts/releases";

// Every picture on this page is a real capture of the application, kept in
// src/assets/ so Astro resizes and re-encodes it at build time. To swap one,
// overwrite the file - the name is the only thing the page knows about it.
import heroShot from "../../assets/shots/hero.png";
// The wide picture's clip: the same window with the edit playing, and the
// picture is its first frame (see Stories.astro, which plays every clip).
import heroClip from "../../assets/clips/hero.mp4";
// The two cards under it each play a clip too: keyframes boxed up and moved
// in the Timeline, and a shader's own rows dragged in Effect controls.
import lanesShot from "../../assets/shots/lanes.png";
import lanesClip from "../../assets/clips/lanes.mp4";
import effectsShot from "../../assets/shots/effects.png";
import effectsClip from "../../assets/clips/effects.mp4";

// Each picture again at the size it was captured, for the enlarged view a
// click opens. At the page's own width the interface in them is too small to
// read, and reading it is the point of showing it.
const fullSize = async (src: ImageMetadata) => ({
  url: (await getImage({ src, width: src.width, quality: 90 })).src,
  w: src.width,
  h: src.height,
});
const heroFull = await fullSize(heroShot);

// The two cards under the wide one.
const shots = [
  {
    src: lanesShot,
    clip: lanesClip,
    full: await fullSize(lanesShot),
    alt: "Lumit's Timeline showing only the keyframed rows of several layers: their names and values on the left, their keyframes in the lanes on the right",
    h: "Intuitively designed.",
    p: "Bring your knowledge directly into Lumit. We know time matters, so you can work without interruption.",
    c: "var(--label-mint)",
  },
  {
    src: effectsShot,
    clip: effectsClip,
    full: await fullSize(effectsShot),
    alt: "Effect controls beside the Viewer: a Custom shader's own Wedges, Turn, Zoom and Slice rows, and the kaleidoscope they fold the picture into",
    h: "Dynamic effects.",
    p: "Effects can be driven by expressions, altered in the node graph, or simply in the effect controls. You decide.",
    c: "var(--label-azure)",
  },
];

// The newest release note, so the link beside the heading never needs editing.
const [latest] = await releasesNewestFirst();
---

<section id="features" class="wrap flex flex-col gap-12 pt-24 pb-20 sm:pt-[120px] sm:pb-28">
  <SectionHead kicker="Welcome to Lumit" title="Composite the way you know." no="01 / 06">
    {
      latest && (
        <a class="release" href={`/releases/${latest.id}`}>
          <span class="release-v">v{latest.data.versionNumber}</span>
          <span>See what is new</span>
        </a>
      )
    }
  </SectionHead>

  {/* The one wide slot under the heading: the application on a real edit, with
      the hero's light coming up behind it, and the edit playing. */}
  <div class="relative" data-reveal style="--i:1">
    <div class="spill" aria-hidden="true"></div>
    <figure class="shot relative m-0 overflow-hidden rounded-card border border-line-2 bg-ink-2">
      <figcaption class="shot-bar"><span>Lumit, mid-edit</span><span>Click to bring forward</span></figcaption>
      <button type="button" class="zoom relative" data-zoom={heroFull.url} data-w={heroFull.w} data-h={heroFull.h} aria-label="Enlarge this screenshot">
        <Image
          class="block w-full"
          src={heroShot}
          alt="Lumit mid-edit: the Viewer showing a burst of light over a night sky, effect controls at the left, effects and presets at the right, and a timeline of layers and keyframes below"
          widths={[720, 1200, 1800]}
          sizes="(min-width: 1360px) 1200px, 100vw"
          loading="eager"
          fetchpriority="high"
          quality={90}
        />
        <video class="clip" data-clip src={heroClip} muted loop playsinline preload="none" tabindex="-1" aria-hidden="true"></video>
      </button>
    </figure>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    {
      shots.map((s, i) => (
        <figure class="lit shot m-0 flex flex-col rounded-card border border-line bg-ink-2" data-reveal style={`--i:${i};--c:${s.c}`}>
          <button type="button" class="zoom relative border-b border-line bg-ink" data-zoom={s.full.url} data-w={s.full.w} data-h={s.full.h} aria-label="Enlarge this screenshot">
            <Image
              class="block w-full"
              src={s.src}
              alt={s.alt}
              widths={[720, 1200, 1800]}
              sizes="(min-width: 1360px) 590px, (min-width: 768px) 46vw, 100vw"
              loading="lazy"
              quality={90}
            />
            <video class="clip" data-clip src={s.clip} muted loop playsinline preload="none" tabindex="-1" aria-hidden="true" />
          </button>
          <figcaption class="flex flex-col gap-2.5 p-7">
            <span class="font-mono text-[18px] tracking-[-0.01em] text-fg">{s.h}</span>
            <span class="text-[15px] leading-[1.4] text-fg-3">{s.p}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  {/* What is in the pictures can be had: the projects page hands them out. */}
  <p class="made" data-reveal>
    <span>The projects in these pictures were made in Lumit, and you can open them yourself.</span>
    <a class="go" href="/projects">Get the projects</a>
  </p>
</section>

<style>
  /* The link to the newest release note: its version, and where it goes. */
  .release {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 12px 5px 5px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-ink-2);
    color: var(--color-fg-2);
    font-size: 14px;
    text-decoration: none;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .release::after {
    content: "\2192";
    transition: transform 0.2s;
  }
  .release:hover {
    border-color: var(--color-line-2);
    color: var(--color-fg);
  }
  .release:hover::after {
    transform: translateX(3px);
  }
  .release-v {
    padding: 4px 7px;
    border-radius: var(--radius-ctl);
    background: color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
  }

  .made {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 32px;
    margin: -16px 0 0;
    color: var(--color-fg-3);
    font-size: 15px;
    line-height: 1.45;
  }

  /* The hero's three colours again, out of focus behind the wide picture, so
     the picture looks lit from behind and not set on a flat page. */
  .spill {
    position: absolute;
    inset: -6% -3% -4%;
    background:
      radial-gradient(45% 60% at 18% 30%, rgb(56 81 156 / 0.6), transparent 70%),
      radial-gradient(40% 55% at 84% 25%, rgb(45 123 137 / 0.55), transparent 70%),
      radial-gradient(50% 55% at 55% 95%, rgb(68 154 120 / 0.45), transparent 70%);
    filter: blur(50px);
    opacity: 0.55;
    pointer-events: none;
  }
</style>
