---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"time"> & { date: Date };
const { date, ...attrs } = Astro.props;
---

<time datetime={date.toISOString()} {...attrs}>
  {
    date.toLocaleDateString("en-GB", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  }
</time>
