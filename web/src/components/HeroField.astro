---
// The hero background.
---

<div class="field" aria-hidden="true">
  <div class="ground"></div>
  <canvas data-field></canvas>
</div>

<style>
  .field {
    position: absolute;
    inset: 0 0 -280px 0;
    pointer-events: none;
    z-index: -1;
  }
  .field > * {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .ground {
    background: var(--color-ink);
  }
  .no-gl .ground {
    background:
      radial-gradient(120% 90% at 20% 20%, #2c3f7a 0%, rgba(44, 63, 122, 0) 55%),
      radial-gradient(90% 80% at 85% 30%, #2a6b4a 0%, rgba(42, 107, 74, 0) 55%),
      radial-gradient(100% 90% at 60% 95%, #6a5f2f 0%, rgba(106, 95, 47, 0) 60%),
      #0f1422;
    -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 58%, transparent 100%);
  }
  canvas {
    opacity: 0;
  }
  canvas.lit {
    opacity: 1;
  }
</style>

<script>
  const VERT = `
    attribute vec2 a;
    void main() { gl_Position = vec4(a, 0.0, 1.0); }
  `;

  const FRAG = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    uniform vec2 u_res;
    uniform float u_t;
    uniform vec4 u_box;
    uniform float u_reveal;
    uniform float u_ms;
    uniform vec2 u_span;

    float hash(vec2 p) {
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
    }

    float noise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
        mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
        u.y
      );
    }

    // A hash that is random at screen coordinates. 
    float phash(vec2 p) {
      vec3 q = fract(vec3(p.xyx) * 0.1031);
      q += dot(q, q.yzx + 33.33);
      return fract((q.x + q.y) * q.z);
    }

    // Interleaved gradient noise. 
    float ign(vec2 p) {
      return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
    }

    // Turblent noise complexity
    float fbm(vec2 p) {
      float v = 0.0;
      float a = 0.5;
      for (int i = 0; i < 4; i++) {
        v += a * noise(p);
        p *= 2.0;
        a *= 0.5;
      }
      return v;
    }

    void main() {
      vec2 uv = gl_FragCoord.xy / u_res;
      vec2 p = vec2(uv.x * (u_res.x / u_res.y), uv.y) * 1.7;
      float t = u_t * 0.055;

      vec2 q = vec2(fbm(p + vec2(0.0, t)), fbm(p + vec2(5.2, 1.3) - t));
      vec2 r = vec2(
        fbm(p + 2.0 * q + vec2(1.7, 9.2) + 0.15 * t),
        fbm(p + 2.0 * q + vec2(8.3, 2.8) - 0.13 * t)
      );
      float f = fbm(p + 2.0 * r);

      // The blue wash is untouched. The other two were a violet and a wine - the
      // accent's family - and are a jade and a moss now: each is its
      // predecessor's channels rearranged, so it keeps the saturation it had
      // and the distance it had from the blue, and only the half of the wheel
      // it sits in moves. moss is the warm one, as the wine was.
      vec3 ink    = vec3(0.059, 0.078, 0.133);  // #0f1422
      vec3 indigo = vec3(0.173, 0.247, 0.478);  // #2c3f7a
      vec3 jade   = vec3(0.165, 0.420, 0.290);  // #2a6b4a
      vec3 moss   = vec3(0.416, 0.373, 0.184);  // #6a5f2f

      vec3 col = ink;
      col = mix(col, indigo, smoothstep(0.30, 0.60, f));
      col = mix(col, jade, smoothstep(0.55, 0.82, length(q)) * 0.85);
      col = mix(col, moss, smoothstep(0.36, 0.58, r.x) * (0.4 + 0.6 * (1.0 - uv.y)));
      col = mix(col, moss, smoothstep(0.95, 1.35, q.y + r.y) * 0.4);

      vec2 gp = gl_FragCoord.xy;
      col += (phash(gp) - 0.5) * 0.036;
      col += (ign(gp) - 0.5) / 255.0;

      vec3 page = vec3(0.043, 0.047, 0.055);  // #0b0c0e, the page itself
      float fade = smoothstep(0.0, 0.42, uv.y);
      float matte = fbm(p * 1.1 + vec2(3.7, 11.3));
      float alpha = clamp(fade * 1.5 - 0.25 + (matte - 0.5) * 0.9, 0.0, 1.0);
      col = mix(page, col, alpha);

      vec2 bd = max(u_box.xy - gl_FragCoord.xy, gl_FragCoord.xy - u_box.zw);
      float bdist = length(max(bd, 0.0)) + min(max(bd.x, bd.y), 0.0);
      float far = length(max(u_box.xy, u_res - u_box.zw)) + 1.0;

      float lead = 7.0;
      float trail = 320.0;
      float inner = -0.5 * min(u_box.z - u_box.x, u_box.w - u_box.y)
        - lead - 20.0;
      float front = mix(inner, far + trail, 1.0 - pow(1.0 - u_reveal, 3.0));
      float vis = 1.0 - smoothstep(front - trail, front + lead, bdist);

      float e = clamp((bdist - inner) / (far + trail - inner), 0.0, 1.0);
      float arrived = (1.0 - pow(1.0 - e, 1.0 / 3.0)) * u_span.x;
      float span = u_span.y * mix(0.38, 1.0, e);
      float age = clamp((u_ms - arrived) / span, 0.0, 1.0);
      float ring = vis
        * (1.0 - age) * (1.0 - age)
        * alpha;
      col = col * (1.0 + ring * 2.2) + vec3(0.30, 0.28, 0.34) * ring * 0.7;

      col = mix(page, col, vis);

      gl_FragColor = vec4(col, 1.0);
    }
  `;

  const REVEAL_MS = 450;
  const GLOW_MS = 1000;

  let cueAt: number | null = matchMedia("(prefers-reduced-motion: reduce)")
    .matches
    ? 0
    : null;
  let onCue = () => {};
  const cue = () => {
    if (cueAt === null) cueAt = performance.now();
    onCue();
  };
  document.addEventListener("wordmark:home", cue, { once: true });
  setTimeout(cue, 2600);

  const whenIdle = (fn: () => void) => {
    const idle = (window as any).requestIdleCallback as
      | ((cb: () => void, o?: { timeout: number }) => void)
      | undefined;
    if (idle) idle(fn, { timeout: 1500 });
    else setTimeout(fn, 200);
  };

  const start = () => {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-field]");
    const gl = canvas?.getContext("webgl", { antialias: false, alpha: false });

    const giveUp = () => {
      canvas?.remove();
      document.querySelector(".field")?.classList.add("no-gl");
    };
    if (!canvas || !gl) {
      giveUp();
      return;
    }

    const compile = (type: number, src: string) => {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      return sh;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);

    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      giveUp();
      return;
    }

    gl.useProgram(prog);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW,
    );
    const a = gl.getAttribLocation(prog, "a");
    gl.enableVertexAttribArray(a);
    gl.vertexAttribPointer(a, 2, gl.FLOAT, false, 0, 0);
    const uRes = gl.getUniformLocation(prog, "u_res");
    const uT = gl.getUniformLocation(prog, "u_t");
    const uBox = gl.getUniformLocation(prog, "u_box");
    const uReveal = gl.getUniformLocation(prog, "u_reveal");
    const uMs = gl.getUniformLocation(prog, "u_ms");
    const uSpan = gl.getUniformLocation(prog, "u_span");

    let box = [0, 0, 0, 0];
    const measure = () => {
      const wm = document.querySelector(".wm");
      const cr = canvas.getBoundingClientRect();
      if (!wm || !cr.width || !cr.height) {
        const cx = canvas.width / 2;
        const cy = canvas.height / 2;
        box = [cx, cy, cx, cy];
        return;
      }
      const b = wm.getBoundingClientRect();
      const sx = canvas.width / cr.width;
      const sy = canvas.height / cr.height;
      const gx = b.width / 2;
      const gy = b.height / 2;
      box = [
        (b.left - gx - cr.left) * sx,
        canvas.height - (b.bottom + gy - cr.top) * sy,
        (b.right + gx - cr.left) * sx,
        canvas.height - (b.top - gy - cr.top) * sy,
      ];
    };

    let revealAt: number | null = null;
    const draw = (now: number) => {
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uT, now / 1000);
      gl.uniform4f(uBox, box[0], box[1], box[2], box[3]);
      gl.uniform2f(uSpan, REVEAL_MS, GLOW_MS);
      const since = revealAt === null ? -1e6 : now - revealAt;
      gl.uniform1f(uMs, since);
      gl.uniform1f(uReveal, Math.min(1, Math.max(0, since / REVEAL_MS)));
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };

    const dpr = Math.min(2, devicePixelRatio || 1);
    const resize = () => {
      canvas.width = Math.max(1, Math.round(canvas.clientWidth * dpr));
      canvas.height = Math.max(1, Math.round(canvas.clientHeight * dpr));
      gl.viewport(0, 0, canvas.width, canvas.height);
    };
    new ResizeObserver(() => {
      resize();
      measure();
      draw(performance.now());
    }).observe(canvas);
    resize();
    measure();

    const readyAt = performance.now();
    draw(readyAt);
    canvas.classList.add("lit");

    const begin = () => {
      measure();
      revealAt = Math.max(cueAt ?? 0, readyAt);
    };
    if (cueAt !== null) begin();
    else onCue = begin;

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      revealAt = 0;
      draw(performance.now());
      return;
    }

    let frame = 0;
    const tick = (ms: number) => {
      draw(ms);
      frame = requestAnimationFrame(tick);
    };
    new IntersectionObserver((entries) => {
      for (const e of entries) {
        cancelAnimationFrame(frame);
        if (e.isIntersecting) frame = requestAnimationFrame(tick);
      }
    }).observe(canvas);
  };

  if (document.readyState === "complete") whenIdle(start);
  else addEventListener("load", () => whenIdle(start), { once: true });
</script>
