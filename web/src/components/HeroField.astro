---
// The hero's ground, drawn rather than painted.
//
// In plain terms: instead of three fixed smears of colour, a small program runs
// on the graphics card for every pixel of the hero, sixty times a second, and
// works out that pixel's colour from its position and the clock. Nothing is
// stored - there is no image and no video - so it never repeats and costs a few
// kilobytes. The technique is the one Caddis uses on their own hero.
//
// The recipe is the standard one for a slow-moving field: value noise, summed
// at four sizes (fbm), then used twice to bend its own coordinates before the
// final lookup. That bending is what turns noise into something that looks like
// it is flowing rather than fizzing.
//
// The same three hues as the static wash it replaces, so the page's colour does
// not change - only its stillness. The wash itself is still here, under the
// canvas, as the whole of the fallback for a browser with no WebGL. The grain
// and the fade into the page below are the shader's work too: a tiled grain
// repeats and the eye finds the tile, and a plain ramp between two dark
// colours is exactly where eight bits a channel runs out and the gradient
// steps into visible arcs.
---

<div class="field" aria-hidden="true">
  <div class="ground"></div>
  <canvas data-field></canvas>
</div>

<style>
  /* The field is taller than the band it sits in - it runs 280 px past the
     bottom and the colour fades out over the last third, so it dies away
     behind the section below instead of stopping at an edge. The overhang is
     why it sits on a negative z-index. */
  .field {
    position: absolute;
    inset: 0 0 -280px 0;
    pointer-events: none;
    /* Behind everything the page draws, but still above the body's own colour:
       the field overhangs the section below, and must pass under its words
       rather than over them. */
    z-index: -1;
  }
  .field > * {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Before the field lights there is nothing behind the wordmark but the page's
     own black, so the hero has one look on the way in rather than a static wash
     that is then replaced by a moving one. The wash this field replaced is
     still here for a browser that gives us no WebGL, but only for that browser
     - and only that path needs a mask to fade out, because the shader fades
     itself. */
  .ground {
    background: var(--color-ink);
  }
  .no-gl .ground {
    background:
      radial-gradient(120% 90% at 20% 20%, #2c3f7a 0%, rgba(44, 63, 122, 0) 55%),
      radial-gradient(90% 80% at 85% 30%, #3a2a6b 0%, rgba(58, 42, 107, 0) 55%),
      radial-gradient(100% 90% at 60% 95%, #6a2f3f 0%, rgba(106, 47, 63, 0) 60%),
      #0f1422;
    -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 58%, transparent 100%);
  }
  /* The field arrives with the wordmark, not with the page: the canvas is
     invisible until the shader has a frame ready AND the lockup has landed,
     and then comes up in the time a frame and a half takes at thirty - a
     lightbulb, not a fade. Until then the hero is black, so nothing flashes
     and nothing competes with the animation. */
  canvas {
    opacity: 0;
    transition: opacity 45ms linear;
  }
  canvas.lit {
    opacity: 1;
  }
</style>

<script>
  const VERT = `
    attribute vec2 a;
    void main() { gl_Position = vec4(a, 0.0, 1.0); }
  `;

  const FRAG = `
    // Screen coordinates run past a thousand, which mediump is not required to
    // represent exactly; every hash here is fed one.
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    uniform vec2 u_res;
    uniform float u_t;

    float hash(vec2 p) {
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
    }

    // Value noise: one random number per lattice corner, smoothly interpolated.
    float noise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
        mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
        u.y
      );
    }

    // A hash that is still random at screen coordinates. The hash above feeds its input straight to sin(), and the
    // dot of two pixel coordinates comes to a few hundred thousand - a number
    // whose sine a 32-bit float can no longer tell you anything useful about.
    // What comes back is not noise but wide, soft bands, which is precisely the
    // artifacting that appeared across the field whenever the grain was built
    // on it. The field itself never noticed, because its own coordinates never
    // leave single figures. This one folds its input down with fract() before
    // it does anything else, so the size of the input cannot matter.
    float phash(vec2 p) {
      vec3 q = fract(vec3(p.xyx) * 0.1031);
      q += dot(q, q.yzx + 33.33);
      return fract((q.x + q.y) * q.z);
    }

    // Interleaved gradient noise. Plain random noise clumps - by chance it puts
    // eight lit pixels in one place and none in the next, which the eye reads
    // as blotches rather than as an even scatter. This spreads its values out
    // instead, which is why it is the standard pattern for dithering and for
    // dissolves, and it costs three instructions.
    float ign(vec2 p) {
      return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
    }

    // Four octaves, each half the size and half the strength of the last. The
    // even halving is what keeps the field wispy: the big shapes carry it and
    // the fine detail only softens their edges. Giving the small octaves more
    // say makes it turbulent instead, which is not what this hero wants.
    float fbm(vec2 p) {
      float v = 0.0;
      float a = 0.5;
      for (int i = 0; i < 4; i++) {
        v += a * noise(p);
        p *= 2.0;
        a *= 0.5;
      }
      return v;
    }

    void main() {
      vec2 uv = gl_FragCoord.xy / u_res;
      vec2 p = vec2(uv.x * (u_res.x / u_res.y), uv.y) * 1.7;
      float t = u_t * 0.055;

      // Bend the coordinates by the noise twice over before the final lookup.
      vec2 q = vec2(fbm(p + vec2(0.0, t)), fbm(p + vec2(5.2, 1.3) - t));
      vec2 r = vec2(
        fbm(p + 2.0 * q + vec2(1.7, 9.2) + 0.15 * t),
        fbm(p + 2.0 * q + vec2(8.3, 2.8) - 0.13 * t)
      );
      float f = fbm(p + 2.0 * r);

      vec3 ink    = vec3(0.059, 0.078, 0.133);  // #0f1422
      vec3 indigo = vec3(0.173, 0.247, 0.478);  // #2c3f7a
      vec3 violet = vec3(0.227, 0.165, 0.420);  // #3a2a6b
      vec3 wine   = vec3(0.416, 0.184, 0.247);  // #6a2f3f

      // Each colour arrives over a short span of the noise rather than drifting
      // across the whole of it. A wide ramp averages the three hues together
      // everywhere, which reads as one soft mush and hides the fine filaments
      // the noise already has; a narrow ramp lets those filaments show, and the
      // filaments are the wisps. Narrow, though, not sharp - the spans still
      // overlap, so blue meets red through violet rather than against it.
      vec3 col = ink;
      col = mix(col, indigo, smoothstep(0.30, 0.60, f));
      col = mix(col, violet, smoothstep(0.55, 0.82, length(q)) * 0.85);
      // The wine is weighted low, as it is in the wash this replaces, but it is
      // no longer confined there: a good part of its strength reaches the top.
      col = mix(col, wine, smoothstep(0.36, 0.58, r.x) * (0.4 + 0.6 * (1.0 - uv.y)));
      // A second, looser pass of the same red, so it reads as a tint through
      // the whole field rather than a single band of it.
      col = mix(col, wine, smoothstep(0.95, 1.35, q.y + r.y) * 0.4);

      // Grain: one value per rendered pixel, which is as fine as grain can be
      // drawn. On a screen that has more device pixels than CSS pixels the
      // canvas is rendered at the higher count, so the grain gets finer with
      // the screen rather than staying a CSS pixel across. It goes on the
      // field's own colour, so it thins out with the field and never lands on
      // the page's black.
      vec2 gp = gl_FragCoord.xy;
      col += (phash(gp) - 0.5) * 0.036;

      // One level of dither underneath it, well below anything the eye reads
      // as texture, so the smooth parts of the field cannot step either.
      col += (ign(gp) - 0.5) / 255.0;

      // The field dissolves into the page's black rather than ramping into it,
      // and it dissolves along the same kind of shape it is made of: the matte
      // is one more sample of the same noise, so the field breaks up into soft
      // patches on the way down instead of thinning evenly. Jittering the ramp
      // per pixel was the earlier attempt at this, and per-pixel speckle over a
      // third of the screen is what read as sand.
      //
      // It takes the banding with it either way. The edge between one 8-bit
      // step and the next can only show when it lies along a straight line, and
      // here there is no straight line for it to lie along.
      vec3 page = vec3(0.043, 0.047, 0.055);  // #0b0c0e, the page itself
      float fade = smoothstep(0.0, 0.42, uv.y);
      float matte = fbm(p * 1.1 + vec2(3.7, 11.3));
      col = mix(page, col, clamp(fade * 1.5 - 0.25 + (matte - 0.5) * 0.9, 0.0, 1.0));

      gl_FragColor = vec4(col, 1.0);
    }
  `;

  // Two things have to happen before the field is visible: it has to have a
  // frame in it, and the wordmark has to be home. They are independent, so each
  // records itself and whichever finishes last does the lighting.
  //
  // The listener is set up here, at the top of the module, and not inside the
  // deferred start below - the wordmark lands about a second and a third in,
  // which is very likely before the browser ever calls us idle.
  let cued = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let lightUp = () => {};
  const cue = () => {
    cued = true;
    lightUp();
  };
  document.addEventListener("wordmark:home", cue, { once: true });
  // No wordmark on the page, or a wordmark that never got going: the field is
  // not held hostage to an event that is not coming.
  setTimeout(cue, 2600);

  // Nothing else runs while the page is still loading. Compiling a shader and
  // drawing the first frame in the middle of a page load is what made the
  // field stutter as it came up: it was competing with the fonts, the images
  // and the layout for the same main thread. Waiting for load and then for the
  // browser to say it is idle costs a few hundred milliseconds of black, which
  // nobody notices, and buys a first frame that lands cleanly.
  const whenIdle = (fn: () => void) => {
    const idle = (window as any).requestIdleCallback as
      | ((cb: () => void, o?: { timeout: number }) => void)
      | undefined;
    if (idle) idle(fn, { timeout: 1500 });
    else setTimeout(fn, 200);
  };

  const start = () => {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-field]");
    const gl = canvas?.getContext("webgl", { antialias: false, alpha: false });

    // No WebGL: the canvas goes, and the ground below it becomes the static
    // wash rather than staying black.
    const giveUp = () => {
      canvas?.remove();
      document.querySelector(".field")?.classList.add("no-gl");
    };
    if (!canvas || !gl) {
      giveUp();
      return;
    }

    const compile = (type: number, src: string) => {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      return sh;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);

    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      giveUp();
      return;
    }

    gl.useProgram(prog);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW,
    );
    const a = gl.getAttribLocation(prog, "a");
    gl.enableVertexAttribArray(a);
    gl.vertexAttribPointer(a, 2, gl.FLOAT, false, 0, 0);
    const uRes = gl.getUniformLocation(prog, "u_res");
    const uT = gl.getUniformLocation(prog, "u_t");

    const draw = (t: number) => {
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uT, t);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };

    // One canvas pixel per device pixel, up to two of them per CSS pixel. The
    // field alone would be happy at half the CSS count and scaled up, but grain
    // that has been through a bilinear resize is mush, and so is a dissolve;
    // and the grain is one pixel across by definition, so how fine it looks is
    // decided here rather than in the shader. The cap is there because the
    // cost is per pixel and a phone at three would pay it three times over.
    const dpr = Math.min(2, devicePixelRatio || 1);
    const resize = () => {
      canvas.width = Math.max(1, Math.round(canvas.clientWidth * dpr));
      canvas.height = Math.max(1, Math.round(canvas.clientHeight * dpr));
      gl.viewport(0, 0, canvas.width, canvas.height);
    };
    new ResizeObserver(() => {
      resize();
      draw(0);
    }).observe(canvas);
    resize();
    // The first frame is drawn here rather than left to the observer above, so
    // the field is ready even if that callback never comes. The clock is
    // already running by the time anyone sees it, which is what makes the fade
    // read as the field switching on mid-motion rather than starting from a
    // standstill.
    draw(0);
    lightUp = () => canvas.classList.add("lit");
    if (cued) lightUp();

    // Reduced motion gets the field, held still - the colour is part of the
    // page, the movement is the part that is optional.
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      draw(0);
      return;
    }

    // The clock only runs while the hero is on screen; scrolled past, the page
    // costs nothing. requestAnimationFrame already stops on a hidden tab, so
    // that case needs no code.
    let frame = 0;
    const tick = (ms: number) => {
      draw(ms / 1000);
      frame = requestAnimationFrame(tick);
    };
    new IntersectionObserver((entries) => {
      for (const e of entries) {
        cancelAnimationFrame(frame);
        if (e.isIntersecting) frame = requestAnimationFrame(tick);
      }
    }).observe(canvas);
  };

  if (document.readyState === "complete") whenIdle(start);
  else addEventListener("load", () => whenIdle(start), { once: true });
</script>
