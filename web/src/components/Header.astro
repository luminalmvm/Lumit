---
// The drawing's bar: the wordmark top-left, plain text destinations at the right
// at 15px on a 28px gap, and the download set apart from them. No icons and no
// reveal animation - the drawing shows words, and a marketing bar with five
// destinations does not need a mechanism.
//
// The narrow set is what survives on a phone; the rest appear from `sm`.
const links = [
  { href: "/#features", label: "Features", small: false },
  { href: "/#roadmap", label: "Roadmap", small: false },
  { href: "/releases", label: "Releases", small: false },
  { href: "https://github.com/luminalmvm/Lumit", label: "Source", small: false },
  { href: "https://docs.lumitlab.com", label: "Docs", small: true },
];
---

<header class="sticky top-0 z-20 transition-colors" data-header>
  <div class="wrap flex h-16 items-center">
    <a href="/" class="mr-auto flex items-center no-underline">
      <img src="/lumit-wordmark.svg" alt="Lumit" height="18" class="block h-[18px] w-auto" />
    </a>
    <nav class="flex items-center gap-5 text-[15px] sm:gap-7">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "text-fg no-underline transition-colors hover:text-accent-2",
              !l.small && "hidden sm:inline",
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="/download"
        class="text-fg no-underline transition-colors hover:text-accent-2 sm:ml-[32px]"
      >
        Download
      </a>
    </nav>
  </div>
</header>

<style>
  /* The bar rides on the hero's own wash, as the drawing draws it, and only
     grows a ground once the page has scrolled far enough for content to pass
     underneath it. Without script it simply stays clear, which is what it looks
     like at the top of every page anyway. */
  [data-header].scrolled {
    background: color-mix(in srgb, var(--color-ink) 80%, transparent);
    border-bottom: 1px solid var(--color-line);
    backdrop-filter: blur(20px);
  }
</style>

<script is:inline>
  (function () {
    var h = document.querySelector("[data-header]");
    if (!h) return;
    var upd = function () {
      h.classList.toggle("scrolled", window.scrollY > 8);
    };
    addEventListener("scroll", upd, { passive: true });
    upd();
  })();
</script>
