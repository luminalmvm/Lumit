---
// The drawing's bar: the wordmark top-left, plain text destinations at the right
// at 15px on a 28px gap, and the download set apart from them. No icons and no
// reveal animation - the drawing shows words, and a marketing bar with five
// destinations does not need a mechanism.
//
// The narrow set is what survives on a phone; the rest appear from `sm`.
const links = [
  { href: "https://docs.lumitlab.com", label: "Docs", small: true },
  { href: "https://github.com/luminalmvm/Lumit", label: "Source", small: false },
  { href: "/releases", label: "Releases", small: false },
  { href: "https://discord.gg/dc3p3XC7mM", label: "Discord", small: false },
  { href: "/sponsor", label: "Sponsor", small: false },
];
---

<header class="sticky top-0 z-20">
  <div class="blur-stack" aria-hidden="true">
    <div></div>
    <div></div>
    <div></div>
    <div></div>
  </div>
  <div class="wrap relative flex h-16 items-center">
    <a href="/" class="mr-auto flex items-center no-underline">
      <img src="/lumit-wordmark.svg" alt="Lumit" height="18" class="block h-[18px] w-auto" />
    </a>
    <nav class="flex items-center gap-5 text-[15px] sm:gap-7">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "text-fg no-underline transition-colors hover:text-accent-2",
              !l.small && "hidden sm:inline",
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="/download"
        class="text-fg no-underline transition-colors hover:text-accent-2 sm:ml-[32px]"
      >
        Download
      </a>
    </nav>
  </div>
  {/* The page is a timeline too: a playhead along the top edge that follows
      the scroll. CSS alone, and absent where the browser cannot do it. Last
      in the bar, so it is drawn over the blurred ground and not through it. */}
  <div class="playhead" aria-hidden="true"><i></i></div>
</header>

<style>
  .playhead {
    position: absolute;
    inset: 0 0 auto 0;
    display: none;
    height: 2px;
    pointer-events: none;
  }
  .playhead::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, transparent, var(--color-accent-2));
    transform-origin: left;
  }
  .playhead i {
    position: absolute;
    top: 0;
    left: 0;
    margin-left: -5px;
    border: 5px solid transparent;
    border-top: 7px solid var(--color-accent-2);
  }
  @supports (animation-timeline: scroll()) {
    .playhead {
      display: block;
    }
    .playhead::before {
      animation: playhead-fill linear both;
      animation-timeline: scroll(root block);
    }
    .playhead i {
      animation: playhead-move linear both;
      animation-timeline: scroll(root block);
    }
  }
  @keyframes playhead-fill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @keyframes playhead-move {
    from { left: 0; }
    to { left: 100%; }
  }

  /* The bar always carries its own ground, on every page and at every scroll
     position. It used to grow one only once the page had scrolled, which meant
     a visible darkening the moment you began to move - the ground arriving is
     more distracting than the ground simply being there.

     The ground is not flat. It is four blurred bands, each one starting lower
     than the last, so blur and ink both deepen towards the top edge and reach
     nothing at the bottom of the bar. One blurred layer under a fading mask
     would fade only the ink - the blur would stay even. Stacking is what makes
     the blur itself graduate. */
  .blur-stack {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .blur-stack > div {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-ink) 30%, transparent);
  }
  .blur-stack > div:nth-child(1) {
    backdrop-filter: blur(2px);
    -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 45%);
    mask-image: linear-gradient(to top, transparent 0%, #000 45%);
  }
  .blur-stack > div:nth-child(2) {
    backdrop-filter: blur(3px);
    -webkit-mask-image: linear-gradient(to top, transparent 25%, #000 65%);
    mask-image: linear-gradient(to top, transparent 25%, #000 65%);
  }
  .blur-stack > div:nth-child(3) {
    backdrop-filter: blur(5px);
    -webkit-mask-image: linear-gradient(to top, transparent 50%, #000 85%);
    mask-image: linear-gradient(to top, transparent 50%, #000 85%);
  }
  .blur-stack > div:nth-child(4) {
    backdrop-filter: blur(8px);
    -webkit-mask-image: linear-gradient(to top, transparent 72%, #000 100%);
    mask-image: linear-gradient(to top, transparent 72%, #000 100%);
  }
</style>
