---
import ReleaseDate from "./ReleaseDate.astro";

interface Props {
  id: string;
  versionNumber: string;
  date: Date;
  /** A single release on its own page: no link back to itself, no divider. */
  single?: boolean;
  /** Last entry on the index: the rule under the notes would dangle, so drop it. */
  last?: boolean;
}
const { id, versionNumber, date, single = false, last = false } = Astro.props;

// The version pill and date. On the single-release page they are static text;
// on the index they are the link into the release's own page.
const Rail = single ? "div" : "a";
const railProps = single ? {} : { href: `/releases/${id}` };
---

{/* Starlog's shape: a sticky left rail carrying the version, the notes beside
    it. Below the tablet breakpoint the rail stacks above its notes instead. */}
<article class="flex w-full flex-col md:flex-row">
  <div class="mt-10 shrink-0 grow-0 basis-0 md:mt-16 md:basis-[200px] lg:basis-[240px]">
    <div class="md:sticky md:top-[86px]">
      <Rail {...railProps} class="inline-block no-underline">
        <span
          class="inline-block rounded-ctl border border-line bg-ink-2 px-2.5 py-1 font-mono
                 text-[13px] leading-none text-fg transition-colors hover:border-line-2"
        >
          v{versionNumber}
        </span>
        <ReleaseDate
          date={date}
          class="mt-2 block font-mono text-[12.5px] text-fg-3 max-md:mt-0 max-md:ml-3 max-md:inline"
        />
      </Rail>
    </div>
  </div>
  <div
    class:list={[
      "release-prose min-w-0 py-6 md:py-16",
      !single && !last && "border-b border-line",
    ]}
  >
    <slot />
  </div>
</article>
