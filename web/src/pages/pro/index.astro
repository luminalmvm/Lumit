---
import Base from "../../layouts/Base.astro";
import SectionHead from "../../components/SectionHead.astro";
import { Image } from "astro:assets";
import shareShot from "../../assets/shots/pro-share.png";
import syncShot from "../../assets/shots/pro-sync.png";
import previewShot from "../../assets/shots/pro-preview.png";
import phoneShot from "../../assets/shots/pro-preview-phone.png";
import historyShot from "../../assets/shots/pro-history.png";
// Each picture's clip is the same box, recorded from Lumit and from a preview's
// own page, and the picture is the clip's first frame.
import shareClip from "../../assets/clips/pro-share.mp4";
import syncClip from "../../assets/clips/pro-sync.mp4";
import previewClip from "../../assets/clips/pro-preview.mp4";
import phoneClip from "../../assets/clips/pro-preview-phone.mp4";
import historyClip from "../../assets/clips/pro-history.mp4";
import phoneAppShot from "../../assets/shots/story-iphone.jpg";
import { MONTHLY, YEARLY, SAVING } from "../../scripts/pro";

// What Pro is, what it costs, and how to get it. Nothing is bought on this
// page: Pro is bought from inside Lumit, where the account is.

// The first two share a row and the others have one each. `sizes` is how wide
// a picture is drawn.
const features = [
  {
    h: "Multi-edit anywhere",
    p: "Guests join through Lumit's relay, with no additional setup.",
    c: "mint",
    shot: shareShot,
    clip: shareClip,
    alt: "Lumit's Multi-edit window, with the project kept online and two people joining it.",
    wide: false,
    sizes: "(min-width: 1360px) 424px, (min-width: 1024px) 34vw, 100vw",
  },
  {
    h: "Settings on every device",
    p: "Shortcuts, themes, workspaces, and presets follow you.",
    c: "azure",
    shot: syncShot,
    clip: syncClip,
    alt: "The Account page of Lumit's settings: a Pro account, and a switch for each group of settings kept in sync.",
    wide: false,
    sizes: "(min-width: 1360px) 756px, (min-width: 1024px) 60vw, 100vw",
  },
  {
    h: "Preview with feedback",
    p: "Share previews, and people can leave feedback with timestamps.",
    c: "amber",
    shot: previewShot,
    clip: previewClip,
    alt: "A preview's page in a browser: the video, a drawing on its picture, and comments beside it with their times.",
    phone: {
      shot: phoneShot,
      clip: phoneClip,
      alt: "The same preview on a phone, with the comments under the video.",
    },
    wide: true,
    sizes: "(min-width: 1360px) 850px, 75vw",
  },
  {
    h: "Never lose an edit",
    p: "Save every change made, online. Revert to any point you want.",
    c: "violet",
    shot: historyShot,
    clip: historyClip,
    alt: "Lumit's Project history window: every save of a project down the left, and the picture of the one chosen.",
    wide: true,
    sizes: "(min-width: 1360px) 1200px, 100vw",
  },
  {
    h: "Exports on your phone",
    p: "Start and follow exports from Lumit for iPhone.",
    c: "azure",
    shot: phoneAppShot,
    alt: "Lumit for iPhone: the Exports tab following an export on Studio PC, and a preview with its comments.",
    wide: true,
    sizes: "(min-width: 1360px) 1200px, 100vw",
  },
];

// The whole editor is on the left and it stays there.
const compare = [
  { what: "Every effect, export format, and resolution", free: true, pro: true },
  { what: "Multi-edit through your own relay, or network", free: true, pro: true },
  { what: "Profiles on one machine, each with its own settings", free: true, pro: true },
  { what: "Multi-edit through Lumit's relay, accessible from any device", free: false, pro: true },
  { what: "Multi-edit projects kept online while you're away", free: false, pro: true },
  { what: "Settings synced across your devices", free: false, pro: true },
  { what: "Save and send previews, and receive comments with timestamps within Lumit", free: false, pro: true },
  { what: "Start and follow exports from Lumit for iPhone", free: false, pro: true },
  { what: "Backup every save and revert at any time", free: false, pro: true },
];

const steps = [
  {
    h: "Open Lumit",
    p: "In the bottom left open the menu.",
  },
  {
    h: "Sign in",
    p: "With Google, Discord, or an email.",
  },
  {
    h: "Pick your plan",
    p: "Both monthly and yearly options are provided.",
  },
];

const questions = [
  {
    q: "Is Lumit still free?",
    a: "Yes. We will never move editing tools behind a paywall.",
  },
  {
    q: "Can Lumit's relay read my project?",
    a: "No. Everything is encrypted, so the only people who see your projects are those you share them with.",
  },
  {
    q: "Does everyone sharing a project need Pro?",
    a: "No, only the host does. Guests accessing the shared project don't need Pro.",
  },
  {
    q: "What data do you keep about me?",
    a: "Your email, name, the settings you sync, and what you back up or send for review. Never your bank details.",
  },
  {
    q: "How much can I store?",
    a: "50 GB.",
  },
  {
    q: "What happens if I cancel?",
    a: "Pro will continue until the next renewal period.",
  },
  {
    q: "Can I get a refund?",
    a: "Yes, within 14 days of paying.",
  },
];
---

<Base
  title="Lumit Pro"
  description="Additional features to make life easier."
>
  <script is:inline>
    document.documentElement.classList.add("anim");
  </script>
  <section class="pt-14 pb-20 sm:pt-20 sm:pb-24">
    <div class="wrap flex flex-col gap-12">
      <p class="lockup" aria-hidden="true">
        <img src="/lumit-wordmark.svg" alt="" height="30" />
        <span class="badge"><span class="sweep">Pro</span></span>
      </p>
      <SectionHead page kicker="Lumit Pro" title="Work together from anywhere.">
        <Fragment slot="lede">
          Lumit is free and open source, and that will never change.
        </Fragment>
      </SectionHead>

      <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1.1fr)]">
        <div class="plan card" data-plan="monthly">
          <p class="tag">Monthly</p>
          <p class="price"><span>${MONTHLY}</span><small>a month</small></p>
        </div>
        <div class="plan plan-pick card" data-plan="yearly">
          <p class="tag"><span>Yearly</span><span class="save">Save {SAVING}%</span></p>
          <p class="price"><span>${YEARLY}</span><small>a year</small></p>
        </div>
        <div class="card flex flex-col justify-between gap-6">
          <p class="text-[15px] leading-[1.45] text-fg-2">
            Get Pro in Lumit, from your profile in the bottom left.
          </p>
          <div class="flex flex-wrap gap-3">
            <a class="btn border-white" href="/download">Download Lumit</a>
            <a class="btn btn-ghost" href="#get">How to get Pro</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-20 sm:pb-24">
    <div class="wrap flex flex-col gap-12">
      <SectionHead kicker="What you get" title="What Pro adds." />
      <div class="features grid gap-5">
        {
          features.map((f, i) => (
            <figure class:list={["lit m-0 flex flex-col rounded-card border border-line bg-ink-2", f.wide && "lg:col-span-2"]} style={`--c:var(--label-${f.c});--i:${i % 2}`} data-reveal>
              <div class:list={["stage", f.phone && "pair"]}>
                <div class="frame">
                  <Image src={f.shot} alt={f.alt} widths={[720, 1000, 1400]} sizes={f.sizes} loading="lazy" quality={90} />
                  {f.clip && <video class="clip" data-clip src={f.clip} muted loop playsinline preload="none" tabindex="-1" aria-hidden="true" />}
                </div>
                {f.phone && (
                  <div class="frame phone">
                    <Image src={f.phone.shot} alt={f.phone.alt} widths={[390, 780]} sizes="(min-width: 640px) 250px, 70vw" loading="lazy" quality={90} />
                    <video class="clip" data-clip src={f.phone.clip} muted loop playsinline preload="none" tabindex="-1" aria-hidden="true" />
                  </div>
                )}
              </div>
              <figcaption class="p-7">
                <p class="num"><i />{String(i + 1).padStart(2, "0")}</p>
                <h3 class="mt-6 text-[22px] leading-[1.15] tracking-[-0.02em] text-fg">{f.h}</h3>
                <p class="mt-2.5 text-[15px] leading-[1.45] text-fg-3">{f.p}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pb-20 sm:pb-24">
    <div class="wrap flex flex-col gap-12">
      <SectionHead kicker="Free and Pro" title="The editor stays free." />
      <div class="card overflow-x-auto p-0">
        <table class="compare">
          <thead>
            <tr><th></th><th>Free</th><th><span class="sweep">Pro</span></th></tr>
          </thead>
          <tbody>
            {
              compare.map((row) => (
                <tr>
                  <td>{row.what}</td>
                  <td>{row.free ? <i class="key" style="--k:var(--color-fg-3)" aria-label="Yes" /> : <i class="key key-hollow" style="--k:var(--color-line-2)" aria-label="No" />}</td>
                  <td>{row.pro ? <i class="key" style="--k:var(--label-mint)" aria-label="Yes" /> : <i class="key key-hollow" aria-label="No" />}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="pb-20 sm:pb-24" id="get">
    <div class="wrap flex flex-col gap-12">
      <SectionHead kicker="Getting it" title="Three steps, inside Lumit." />
      <ol class="m-0 grid list-none gap-5 p-0 md:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="card" data-reveal>
              <p class="num"><i style="background:var(--color-accent-2)" />{String(i + 1).padStart(2, "0")}</p>
              <h3 class="mt-8 text-[19px] text-fg">{s.h}</h3>
              <p class="mt-2.5 text-[15px] leading-[1.45] text-fg-3">{s.p}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="pb-24 sm:pb-32">
    <div class="wrap flex flex-col gap-12">
      <SectionHead kicker="Questions" title="FAQ." />
      <div class="faq">
        {
          questions.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
      <p class="text-[13px] leading-[1.5] text-fg-4">
        <a class="link" href="/terms">Terms</a>, <a class="link" href="/privacy">privacy</a>, and
        <a class="link" href="/refunds">refunds</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  /* The two keys of the mark run together. Only Pro is drawn in it. */
  .sweep {
    background: linear-gradient(135deg, var(--key-jade), var(--key-sky));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lockup {
    display: flex;
    align-items: center;
    /* The wordmark's file has room either side of the mark, which is taken
       back here so the badge stands beside the letters. */
    gap: 0;
    margin: 0 0 -8px -20px;
  }
  .lockup img {
    display: block;
    height: 30px;
    width: auto;
  }
  /* The badge Lumit itself puts beside a Pro account's name. */
  .badge {
    position: relative;
    padding: 1px;
    border-radius: 4px;
    background: linear-gradient(135deg, var(--key-jade), var(--key-sky));
  }
  .badge::before {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: 3px;
    background: var(--color-ink);
  }
  .badge .sweep {
    position: relative;
    display: block;
    padding: 4px 8px 3px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .plan .tag {
    display: flex;
    justify-content: space-between;
  }
  .plan .save {
    color: var(--label-mint);
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 32px 0 0;
    color: var(--color-fg);
    font-size: 40px;
    line-height: 1;
    font-feature-settings: "tnum";
  }
  .price small {
    color: var(--color-fg-4);
    font-size: 15px;
  }
  /* The plan most people should take, edged in the sweep. */
  .plan-pick {
    --pick: color-mix(in srgb, var(--key-jade) 5%, var(--color-ink-2));
    position: relative;
    border-color: transparent;
    background:
      linear-gradient(var(--pick), var(--pick)) padding-box,
      linear-gradient(var(--turn), var(--key-jade), var(--key-sky)) border-box;
    animation: turn 9s linear infinite;
  }
  /* The sweep goes slowly round the edge. An angle has to be registered to
     be animated, and without that the edge just stands at 135. */
  @property --turn {
    syntax: "<angle>";
    inherits: false;
    initial-value: 135deg;
  }
  @keyframes turn {
    to {
      --turn: 495deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plan-pick {
      animation: none;
    }
  }
  /* Where a feature's picture stands. One picture fills it to the edges. */
  .stage {
    position: relative;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-ink);
  }
  .frame {
    position: relative;
    overflow: hidden;
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The two pictures that share a row are different shapes. Each column is as
     wide as its picture is to its height, which makes the two the same height. */
  @media (min-width: 1024px) {
    .features {
      grid-template-columns: minmax(0, 0.799fr) minmax(0, 1.426fr);
    }
  }
  /* A preview on a computer and on a phone, side by side on a lit ground.
     The columns are as wide as makes the two the same height. */
  .pair {
    display: grid;
    grid-template-columns: 3.411fr 1fr;
    gap: 28px;
    align-items: center;
    padding: 40px;
    background:
      radial-gradient(60% 90% at 12% 0%, color-mix(in srgb, var(--c) 13%, transparent), transparent 70%),
      radial-gradient(50% 80% at 100% 100%, color-mix(in srgb, var(--key-sky) 9%, transparent), transparent 70%),
      var(--color-ink);
  }
  .pair::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--grain);
    opacity: 0.05;
    mix-blend-mode: overlay;
    pointer-events: none;
  }
  .pair .frame {
    border: 1px solid var(--color-line-2);
    border-radius: var(--radius-card);
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.7);
  }
  .pair .phone {
    border: 5px solid var(--color-ink-3);
    border-radius: 26px;
    outline: 1px solid var(--color-line-2);
  }
  /* On a phone the phone's own picture is the one that can be read. */
  @media (max-width: 639px) {
    .pair {
      grid-template-columns: minmax(0, 300px);
      justify-content: center;
      padding: 28px 20px;
    }
    .pair .frame:not(.phone) {
      display: none;
    }
  }
  .num {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-fg-4);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    font-feature-settings: "zero";
  }
  .num i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c);
  }
  .compare {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .compare th {
    padding: 16px 28px;
    color: var(--color-fg-3);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .compare td {
    padding: 14px 28px;
    border-top: 1px solid var(--color-line);
    color: var(--color-fg-2);
  }
  .compare th:not(:first-child),
  .compare td:not(:first-child) {
    width: 96px;
    text-align: center;
  }
  .faq {
    border-top: 1px solid var(--color-line);
  }
  .faq details {
    border-bottom: 1px solid var(--color-line);
  }
  /* The tint under the pointer hangs outside the column, so the question
     stays in line with the heading above it. */
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 4px -14px;
    padding: 16px 14px;
    border-radius: var(--radius-card);
    transition: background 0.15s;
    color: var(--color-fg);
    font-size: 17px;
    cursor: pointer;
    list-style: none;
  }
  .faq summary:hover {
    background: var(--color-ink-2);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: "+";
    color: var(--color-fg-4);
    font-family: var(--font-mono);
    transition: transform 0.2s;
  }
  .faq details[open] summary::after {
    transform: rotate(45deg);
  }
  .faq p {
    max-width: 680px;
    margin: 0 0 22px;
    color: var(--color-fg-3);
    font-size: 15px;
    line-height: 1.5;
  }
</style>

<script>
  import "../../scripts/clips";

  // Each part of the page arrives as it is scrolled to.
  const seen = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add("shown");
        seen.unobserve(entry.target);
      }
    },
    { rootMargin: "0px 0px -8% 0px" },
  );
  for (const el of document.querySelectorAll("[data-reveal]")) seen.observe(el);
</script>
