---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import SectionHead from "../../components/SectionHead.astro";
import ReleaseEntry from "../../components/ReleaseEntry.astro";
import { releasesNewestFirst } from "../../scripts/releases";

const releases = await releasesNewestFirst();
const rendered = await Promise.all(
  releases.map(async (release) => ({ release, Content: (await render(release)).Content })),
);
---

<Base
  title="Releases - Lumit"
  description="Lumit changelog"
>
  <section class="pt-14 pb-24 sm:pt-20 sm:pb-32">
    <div class="wrap">
      <SectionHead page kicker="Releases" title="Changelog.">
        <Fragment slot="lede">
          <a class="link" href="/releases/rss.xml">RSS feed</a>
        </Fragment>
      </SectionHead>

      {
        rendered.length === 0 ? (
          <div class="card mt-12 max-w-[58ch]">
            <h2 class="text-[19px]">Nothing here yet</h2>
            <p class="mt-3">
              Notes for the first release are still being written. Until they land, the
              tags and their assets are on
              <a class="link" href="https://github.com/luminalmvm/Lumit/releases">GitHub releases</a>.
            </p>
          </div>
        ) : (
          <>
            {/* Every version on one line, since the page under it is long. */}
            <nav class="jump" aria-label="Versions">
              <span class="tag">Jump to</span>
              {releases.map((r, i) => (
                <a href={`#v${r.data.versionNumber}`} class:list={[i === 0 && "newest"]}>
                  v{r.data.versionNumber}
                </a>
              ))}
            </nav>
            {/* The newest two are on the page from the start. The rest wait in
                templates and join as the reader scrolls (script below). */}
            <div class="mt-4" data-releases>
              {rendered.map(({ release, Content }, i) => {
                const entry = (
                  <ReleaseEntry
                    id={release.id}
                    versionNumber={release.data.versionNumber}
                    date={release.data.date}
                    latest={i === 0}
                    last={i === rendered.length - 1}
                  >
                    <Content />
                  </ReleaseEntry>
                );
                return i < 2 ? entry : <template data-version={`v${release.data.versionNumber}`}>{entry}</template>;
              })}
            </div>
            <div data-more aria-hidden="true"></div>
          </>
        )
      }
    </div>
  </section>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 40px;
    padding: 12px 14px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-ink-2);
  }
  .jump .tag {
    margin-right: 8px;
  }
  .jump a {
    padding: 6px 9px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-ctl);
    color: var(--color-fg-2);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  @media (pointer: coarse) {
    .jump a {
      padding: 15px 12px;
    }
  }
  .jump a:hover {
    border-color: var(--color-line-2);
    color: var(--color-fg);
  }
  .jump .newest {
    border-color: var(--color-accent-2);
    color: var(--color-fg);
  }
</style>

<script>
  // The next release joins while it is still a couple of screens below, so
  // scrolling never reaches the end of what is there. A jump link, or a link
  // straight to an older version, brings in everything down to it first.
  const list = document.querySelector<HTMLElement>("[data-releases]");
  const more = document.querySelector<HTMLElement>("[data-more]");
  if (list && more) {
    const add = () => {
      const next = list.querySelector("template");
      next?.replaceWith(next.content);
      return next;
    };
    const observer = new IntersectionObserver(
      ([seen]) => {
        if (!seen.isIntersecting) return;
        if (!add()) return observer.disconnect();
        // Watching it afresh reports it again, in case it is still in range.
        observer.unobserve(more);
        observer.observe(more);
      },
      { rootMargin: "0px 0px 200% 0px" },
    );
    observer.observe(more);

    const reach = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id || !list.querySelector(`template[data-version="${CSS.escape(id)}"]`)) return;
      while (!document.getElementById(id) && add());
      document.getElementById(id)?.scrollIntoView();
    };
    addEventListener("hashchange", reach);
    reach();
  }
</script>
