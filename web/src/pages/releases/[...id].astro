---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ReleaseEntry from "../../components/ReleaseEntry.astro";

// One page per release. With the collection empty this yields no paths at all,
// which is a valid build - the index simply has nothing to link to.
export const getStaticPaths: GetStaticPaths = async () => {
  const releases = await getCollection("releases");
  return releases.map((release) => ({ params: { id: release.id }, props: { release } }));
};

const { release } = Astro.props;
const { Content } = await render(release);
---

<Base
  title={`${release.data.title} - Lumit`}
  description={release.data.description}
>
  <section class="pt-16 pb-24 sm:pt-20 sm:pb-32">
    <div class="wrap">
      <a href="/releases" class="kicker no-underline hover:text-fg-2">All releases</a>
      <h1 class="mt-4 text-[clamp(30px,3.8vw,42px)] leading-[1.05]">
        {release.data.title}
      </h1>
      <div class="mt-8">
        <ReleaseEntry
          id={release.id}
          versionNumber={release.data.versionNumber}
          date={release.data.date}
          single
        >
          <Content />
        </ReleaseEntry>
      </div>
    </div>
  </section>
</Base>
