---
import Base from "../layouts/Base.astro";

// One page, one button. The site never touches a payment: GitHub Sponsors
// processes everything, and the whole of this page's job is to say so plainly
// and link there (the same posture as .github/FUNDING.yml on the repo).
const SPONSORS = "https://github.com/sponsors/luminalmvm";

const answers = [
  {
    th: "What it helps",
    td: "Development time. Lumit is completely unfunded and all work on it is unpaid.",
  },
  {
    th: "What it doesn't buy",
    td: "Features. Sponsors are incredibly kind, but they don't buy features. If something isn't planned, you are welcome to contribute code on Github.",
  },
  {
    th: "How it is handled",
    td: "Entirely by GitHub Sponsors. At no point will Lumit ever see your details.",
  },
];
---

<Base
  title="Sponsor Lumit"
  description="Sponsor Lumit's development through GitHub Sponsors. Everything ships free under GPLv3 either way."
>
  <section class="py-16 sm:py-24">
    <div class="wrap">
      <p class="kicker">Sponsor</p>
      <h2 class="mt-4 text-[clamp(28px,3.4vw,36px)] leading-[1.1]">Help the development of Lumit.</h2>
      <p class="mt-4 max-w-[620px]">
        Lumit is free and open source, and we want to keep it that way. If you use Lumit and want to
        help development please consider sponsoring or contributing features on Github.
      </p>

      <div class="mt-9">
        <a class="btn" href={SPONSORS}>Sponsor on GitHub</a>
      </div>

      <table class="mt-14 w-full max-w-[720px] border-collapse text-[15px]">
        <tbody>
          {
            answers.map((a) => (
              <tr class="border-t border-line">
                <th class="w-[180px] py-4 pr-6 text-left align-top font-normal text-fg">{a.th}</th>
                <td class="py-4 leading-[1.5] text-fg-3">{a.td}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>
