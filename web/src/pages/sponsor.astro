---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";

// One page, one button. The site never touches a payment: GitHub Sponsors
// processes everything, and the whole of this page's job is to say so plainly
// and link there (the same posture as .github/FUNDING.yml on the repo).
const SPONSORS = "https://github.com/sponsors/luminalmvm";
const REPO = "https://github.com/luminalmvm/Lumit";

const answers = [
  {
    th: "What it helps",
    td: "Development time. Lumit is completely unfunded and all work on it is unpaid.",
    c: "mint",
  },
  {
    th: "What it doesn't buy",
    td: "Features. Sponsors are incredibly kind, but they don't buy features. If something isn't planned, you are welcome to contribute code on Github.",
    c: "amber",
  },
  {
    th: "How it is handled",
    td: "Entirely by GitHub Sponsors. At no point will Lumit ever see your details.",
    c: "azure",
  },
];

// Money is one way to help and not the only one.
const ways = [
  {
    href: REPO,
    h: "Contribute code",
    p: "The whole engine and interface are on GitHub, and pull requests are welcome.",
  },
  {
    href: "/translate",
    h: "Translate",
    p: "Translations for Lumit are completely community-sourced.",
  },
  {
    href: `${REPO}/issues`,
    h: "Report an issue",
    p: "Test Lumit and report any issues, so that we can clean them all up.",
  },
  {
    href: "https://discord.gg/dc3p3XC7mM",
    h: "Join the Discord",
    p: "Talk to other editors and follow development.",
  },
];
---

<Base
  title="Sponsor Lumit"
  description="Sponsor Lumit's development through GitHub Sponsors. Everything ships free under GPLv3 either way."
>
  <section class="pt-14 pb-20 sm:pt-20 sm:pb-28">
    <div class="wrap flex flex-col gap-12">
      <SectionHead page kicker="Sponsor" title="Help the development of Lumit.">
        <Fragment slot="lede">
          Lumit is free and open source, and we want to keep it that way. If you use Lumit and want to
          help development please consider sponsoring or contributing features on Github.
        </Fragment>
      </SectionHead>

      <div>
        <a class="btn border-white" href={SPONSORS}>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M8 13.5S2 10 2 5.9A3.1 3.1 0 0 1 8 4.6 3.1 3.1 0 0 1 14 5.9C14 10 8 13.5 8 13.5Z"></path>
          </svg>
          Sponsor on GitHub
        </a>
      </div>

      <dl class="m-0 grid gap-5 md:grid-cols-3">
        {
          answers.map((a, i) => (
            <div class="card lit" style={`--c:var(--label-${a.c})`}>
              <p class="num"><i />{String(i + 1).padStart(2, "0")}</p>
              <dt class="mt-8 font-mono text-[15px] text-fg">{a.th}</dt>
              <dd class="m-0 mt-2.5 text-[15px] leading-[1.45] text-fg-3">{a.td}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="pb-24 sm:pb-32">
    <div class="wrap flex flex-col gap-12">
      <SectionHead kicker="Take part" title="Other ways to help." />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          ways.map((w) => (
            <a class="card lit way" href={w.href}>
              <span class="go">{w.h}</span>
              <span class="mt-3 block text-[15px] leading-[1.45] text-fg-3">{w.p}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .num {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-fg-4);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    font-feature-settings: "zero";
  }
  .num i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c);
  }
  .way {
    display: block;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .way:hover {
    border-color: var(--color-line-2);
  }
  .way .go {
    color: var(--color-fg);
    font-size: 15px;
  }
  .way:hover .go::after {
    transform: translateX(3px);
  }
</style>
