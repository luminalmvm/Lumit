---
import Base from "../layouts/Base.astro";
---

<Base title="Not found - Lumit" description="That page does not exist.">
  <section class="pt-14 pb-24 sm:pt-20 sm:pb-32">
    <div class="wrap">
      <div class="sec-rule"><p class="kicker pl-3">Not found</p><span class="sec-no">F404</span></div>
      {/* The number, with the hero's RGB split left on it. */}
      <p class="lost" aria-hidden="true">404</p>
      <h1 class="sec-title">That page does not exist.</h1>
      <p class="lede mt-4">
        It may have moved, or the link may be wrong. The download page and the docs are
        both still where you left them.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="btn border-white" href="/">Back to the start</a>
        <a class="btn btn-ghost" href="/download">Download Lumit</a>
        <a class="btn btn-ghost" href="https://docs.lumitlab.com">Read the docs</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    margin: 48px 0 28px;
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: clamp(96px, 22vw, 240px);
    line-height: 0.85;
    letter-spacing: -0.05em;
    font-feature-settings: "zero";
    text-shadow:
      -0.035em 0 0 rgb(255 40 80 / 0.75),
      0.035em 0 0 rgb(40 140 255 / 0.75);
  }
</style>
