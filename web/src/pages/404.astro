---
import Base from "../layouts/Base.astro";
---

<Base title="Not found - Lumit" description="That page does not exist.">
  <section class="py-24 sm:py-32">
    <div class="wrap">
      <p class="kicker">404</p>
      <h2 class="mt-4 text-[clamp(28px,3.4vw,36px)] leading-[1.1]">That page does not exist.</h2>
      <p class="mt-4 max-w-[620px]">
        It may have moved, or the link may be wrong. The download page and the docs are
        both still where you left them.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="btn" href="/">Back to the start</a>
        <a class="btn btn-ghost" href="/download">Download Lumit</a>
      </div>
    </div>
  </section>
</Base>
