---
import Base from "../layouts/Base.astro";
---

{/*
  Where a browser is left after signing in to Lumit with Discord or Google.
  The sign-in itself has already gone back to Lumit by the time this page is
  shown, so there is nothing here but the news.
*/}
<Base title="Signed in - Lumit" description="You're signed in.">
  <section class="pt-14 pb-24 sm:pt-20 sm:pb-32">
    <div class="wrap">
      <div class="sec-rule"><p class="kicker pl-3">Lumit account</p></div>

      <div id="in-ok">
        <h1 class="sec-title mt-7">You're signed in.</h1>
      </div>

      <div id="in-failed" hidden>
        <h1 class="sec-title mt-7">Sign-in failed.</h1>
        <p class="lede mt-4" id="in-why" hidden></p>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const error = new URLSearchParams(location.search).get("error");
    if (!error) return;
    document.getElementById("in-ok").hidden = true;
    document.getElementById("in-failed").hidden = false;
    const reason = {
      unverified_email: "Verify your email with Google or Discord, then try again.",
      need_birth_date: "Enter your date of birth in Lumit, then try again.",
      too_young: "You're too young for a Lumit account.",
    }[error];
    if (reason) {
      const why = document.getElementById("in-why");
      why.textContent = reason;
      why.hidden = false;
    }
  })();
</script>
