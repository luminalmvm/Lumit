---
import { statSync } from "node:fs";
import { resolve } from "node:path";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";

// The projects the home page's pictures were taken from, to be had as files.
// Each one has its project in public/projects, and in src/assets/projects a
// clip of it playing and one frame of it, which is what stands there until
// the clip has loaded. The clips are played by scripts/clips.ts.
import solsticeShot from "../assets/projects/solstice.png";
import solsticeClip from "../assets/projects/solstice.mp4";
import irisShot from "../assets/projects/iris.png";
import irisClip from "../assets/projects/iris.mp4";
import lumaKeyShot from "../assets/projects/luma-key.png";
import lumaKeyClip from "../assets/projects/luma-key.mp4";
import stackShot from "../assets/projects/stack.png";
import stackClip from "../assets/projects/stack.mp4";
import pulseShot from "../assets/projects/pulse.png";
import pulseClip from "../assets/projects/pulse.mp4";
import morphShot from "../assets/projects/morph.png";
import morphClip from "../assets/projects/morph.mp4";
import floodShot from "../assets/projects/flood-the-grid.png";
import floodClip from "../assets/projects/flood-the-grid.mp4";
import decodeShot from "../assets/projects/decode.png";
import decodeClip from "../assets/projects/decode.mp4";

// A file's size is read off the file, from web/, which is where both
// `astro dev` and `astro build` are run.
const file = (slug: string) => {
  const kb = statSync(resolve(process.cwd(), "public/projects", `${slug}.lum`)).size / 1024;
  return { href: `/projects/${slug}.lum`, size: `${Math.round(kb)} KB` };
};

// The fonts are all free ones. A project opened without its fonts is set in
// Inter, so each card says which to install and where they are.
const font = (name: string) => ({
  name,
  href: `https://fonts.google.com/specimen/${name.replaceAll(" ", "+")}`,
});

const projects = [
  {
    slug: "solstice",
    shot: solsticeShot,
    clip: solsticeClip,
    name: "Solstice",
    tag: "Light and glow",
    p: "Three cameras, 3D layers, and particles.",
    alt: "Cream and amber rays bursting from a bright point over a deep blue night sky",
    layers: 34,
    fonts: [font("Cinzel"), font("Lora")],
    c: "amber",
  },
  {
    slug: "iris",
    shot: irisShot,
    clip: irisClip,
    name: "Iris",
    tag: "Effects and a shader",
    p: "A kaleidoscope from a custom shader and a repeater.",
    alt: "A spiral of small bright eyes turning round a pink light on a dark violet ground",
    layers: 30,
    fonts: [font("Abril Fatface"), font("Raleway"), font("Playfair Display")],
    c: "magenta",
  },
  {
    slug: "luma-key",
    shot: lumaKeyShot,
    clip: lumaKeyClip,
    name: "Luma Key",
    tag: "Isometric",
    p: "An island built with the points effects.",
    alt: "An isometric film studio lot on a floating island, with its name lying on the ground beside it",
    layers: 55,
    fonts: [font("Oswald"), font("Lora")],
    c: "indigo",
  },
  {
    slug: "stack",
    shot: stackShot,
    clip: stackClip,
    name: "Stack",
    tag: "Type and blend modes",
    p: "Blend modes, track mattes, and depth of field.",
    alt: "The words Stack, Blend, Matte and Depth in black on overlapping indigo, mint, amber and coral bands",
    layers: 40,
    fonts: [font("Montserrat"), font("IBM Plex Mono")],
    c: "mint",
  },
  {
    slug: "pulse",
    shot: pulseShot,
    clip: pulseClip,
    name: "Pulse",
    tag: "Interface motion",
    p: "One camera move, glow, and expressions.",
    alt: "A music player card seen at an angle in the dark, with a level meter and a volume dial reading 82",
    layers: 85,
    fonts: [font("Montserrat"), font("IBM Plex Mono")],
    c: "azure",
  },
  {
    slug: "morph",
    shot: morphShot,
    clip: morphClip,
    name: "Morph",
    tag: "Shape morph",
    p: "One shape morphed through seven pictures.",
    alt: "A white soundwave of rounded bars on an indigo ground",
    layers: 53,
    fonts: [font("Nunito")],
    c: "coral",
  },
  {
    slug: "flood-the-grid",
    shot: floodShot,
    clip: floodClip,
    name: "Flood the Grid",
    tag: "Type fill",
    p: "Bands of words that scroll through two shapes, squeezing round them and swelling inside.",
    alt: "Rows of the words Flood the Grid in black on cream, framed by small captions, with the phrase set large in coral inside a black oval across the middle",
    layers: 22,
    fonts: [font("Bebas Neue"), font("IBM Plex Mono")],
    credit: [
      { name: "andrea68", href: "https://github.com/andrea68git" },
      { pre: ", after ", name: "Submesh Boolean by Tim Klinke", href: "https://scenery.io/scenes/submesh-boolean-sXzoRIUKUVW/" },
    ],
    c: "violet",
  },
  {
    slug: "decode",
    shot: decodeShot,
    clip: decodeClip,
    name: "Decode",
    tag: "Drivers and points",
    p: "A word in characters that scramble and settle as rings pass.",
    alt: "The word Decode spelt in small white characters on a deep blue ground, some turned and coloured where a ring is passing",
    layers: 8,
    fonts: [font("Bebas Neue"), font("IBM Plex Mono")],
    credit: [{ name: "andrea68", href: "https://github.com/andrea68git" }],
    c: "teal",
  },
].map((project) => ({ ...project, file: file(project.slug) }));
---

<Base
  title="Projects - Lumit"
  description="Projects to download and take apart."
>
  <section class="pt-14 pb-24 sm:pt-20 sm:pb-32">
    <div class="wrap flex flex-col gap-14">
      <SectionHead page kicker="Projects" title="Made in Lumit.">
        <Fragment slot="lede">
          Eight projects to download and take apart.
        </Fragment>
      </SectionHead>

      <div class="grid gap-5 lg:grid-cols-2">
        {
          projects.map((project, n) => (
            <article class="project lit" style={`--c:var(--label-${project.c})`}>
              <div class="picture">
                <Image
                  class="block w-full"
                  src={project.shot}
                  alt={project.alt}
                  widths={[640, 960, 1280]}
                  sizes="(min-width: 1360px) 590px, (min-width: 1024px) 46vw, 100vw"
                  loading={n < 2 ? "eager" : "lazy"}
                  quality={88}
                />
                <video class="clip" data-clip src={project.clip} muted loop playsinline preload="none" tabindex="-1" aria-hidden="true" />
              </div>
              <div class="body">
                <p class="tag"><i class="dot" />{project.tag}</p>
                <h2 class="mt-3 text-[26px] leading-[1.1] tracking-[-0.03em]">{project.name}</h2>
                <p class="mt-3 max-w-[520px] text-[15px] leading-[1.45] text-fg-3">{project.p}</p>

                <dl class="facts">
                  <div>
                    <dt>Length</dt>
                    <dd>10 seconds, {project.layers} layers</dd>
                  </div>
                  {project.credit && (
                    <div>
                      <dt>By</dt>
                      <dd>
                        {/* Kept on one line, or a space lands before each comma. */}
                        {project.credit.map((c) => <Fragment>{c.pre}<a href={c.href}>{c.name}</a></Fragment>)}
                      </dd>
                    </div>
                  )}
                  <div>
                    <dt>Fonts</dt>
                    <dd>
                      {/* Kept on one line, or a space lands before each comma. */}
                      {project.fonts.map((f, i) => <Fragment>{i > 0 && ", "}<a href={f.href}>{f.name}</a></Fragment>)}
                    </dd>
                  </div>
                </dl>

                <div class="get">
                  <a class="btn" href={project.file.href} download>
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path d="M8 2v9M4 7l4 4 4-4M2 13h12" />
                    </svg>
                    Download
                    <span class="size">{project.file.size}</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .project {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-ink-2);
  }
  /* The picture, and the clip that lies over it once it is playing. */
  .picture {
    position: relative;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-ink);
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 28px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c);
  }

  /* What a project is, in a few short rows. */
  .facts {
    display: grid;
    gap: 8px;
    margin: 22px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
  }
  .facts div {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 12px;
  }
  .facts dt {
    color: var(--color-fg-4);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 10px;
    line-height: 1.7;
  }
  .facts dd {
    margin: 0;
    color: var(--color-fg-2);
  }
  .facts a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-line-2);
    text-underline-offset: 3px;
    transition:
      color 0.15s,
      text-decoration-color 0.15s;
  }
  /* Only where there is a real pointer: a tap would leave it lit. */
  @media (hover: hover) and (pointer: fine) {
    .facts a:hover {
      color: var(--color-fg);
      text-decoration-color: var(--color-accent);
    }
  }

  /* The download sits at the foot of its card, whatever the card's height. */
  .get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: auto;
    padding-top: 24px;
  }
  .size {
    color: var(--color-fg-4);
    font-family: var(--font-mono);
    font-size: 11px;
  }
</style>

<script>
  import "../scripts/clips";
</script>
