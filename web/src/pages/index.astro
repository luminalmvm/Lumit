---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";
import HeroField from "../components/HeroField.astro";

// Every picture on this page is a real capture of the application, kept in
// src/assets/ so Astro resizes and re-encodes it at build time. To swap one,
// overwrite the file - the name is the only thing the page knows about it.
import heroShot from "../assets/shots/hero.png";
import timelineShot from "../assets/shots/timeline.png";
import nodeGraphShot from "../assets/shots/node-graph.png";
import workspaceShot from "../assets/shots/workspace.png";
import graphShot from "../assets/shots/graph-workspace.png";
import nodesShot from "../assets/shots/nodes-workspace.png";
import audioShot from "../assets/shots/audio-workspace.png";

// The hero line arrives a word at a time. One span per word, each carrying its
// own index; the delay is arithmetic in CSS rather than script.
const tagline =
  "Compositing that adapts to your workflow. Built by editors, for editors. With an application that always remains responsive.";
const words = tagline.split(" ");

// The two cards under the wide one.
const shots = [
  {
    src: timelineShot,
    alt: "Lumit's timeline lanes beside the graph editor: clip bars and keyframes on one side, a property's curve on the other",
    h: "Intuitively designed.",
    p: "Bring your knowledge directly into Lumit. We know time matters, so you can work without interruption.",
  },
  {
    src: nodeGraphShot,
    alt: "Lumit's node graph: a layer wired through two Glows, Add grain, a LUT, Levels and Fast motion blur",
    h: "Dynamic effects.",
    p: "Effects can be driven by expressions, altered in the node graph, or simply in the effect controls. You decide.",
  },
];

// Meet the interface: one picture at a time, chosen by name.
const tabs = [
  {
    src: workspaceShot,
    alt: "The Lumit workspace: effect controls, the viewer and scopes, the effects search open over a full timeline",
    h: "Timeline.",
  },
  {
    src: graphShot,
    alt: "The Graph workspace: effect controls, the viewer and scopes, with a property's curve open in the timeline",
    h: "Graph.",
  },
  {
    src: nodesShot,
    alt: "The Nodes workspace: a wired effect chain across the window, the viewer beside it",
    h: "Nodes.",
  },
  {
    src: audioShot,
    alt: "The Audio workspace: mixer strips and levels at the left, beat detection at the right, a waveform under the timeline",
    h: "Audio.",
  },
];

const features = [
  {
    h: "Retime, two ways",
    p: "One retime, read as a value graph or as a speed graph. With support for both After Effects and Vegas styles of retiming, and switch at any point.",
  },
  {
    h: "Over 100 effects, built in",
    p: "Glow, motion blur, camera shake, RGB split, smooth zoom, colour grading, roto brush and puppet. All GPU-rendered, each with a documentation page for details.",
  },
  {
    h: "A graph editor to work in",
    p: "Value and speed views of the same curves, with support for easing, linear holding, and ways to alter multiple keyframes at once.",
  },
  {
    h: "Cuts inside a layer",
    p: "A Sequence layer holds clips cut back-to-back on one row, each with its own retime, inside a layer, just like an NLE.",
  },
  {
    h: "OFX plugin support",
    p: "Any OFX plugin is supported: Sapphire, Twixtor, and the rest are found at start-up and sit beside built-in effects.",
  },
  {
    h: "Bring your After Effects projects",
    p: "Import After Effects projects directly across into Lumit. Keyframes carry across value for value, with support for all base effects and OFX plugins that Lumit can access.",
  },
  {
    h: "Let music guide you",
    p: "Beat detection marks the audio, cuts and retime features snap to the markers, and any parameter can be driven from a layer's sound.",
  },
  {
    h: "Your work survives the crash",
    p: "Every edit goes through an operation journal, and the project autosaves beside it. Kill Lumit mid-edit and the recovered project is offered on the next launch.",
  },
  {
    h: "The interface never blocks",
    p: "Rendering runs on the GPU, cached work is reused, and preview quality drops when a frame is late. The interface answers while an export runs.",
  },
  {
    h: "Open source, GPLv3",
    p: "The whole engine and interface, in the open. No subscription, no per-seat licence, and no plugin tax on the basics.",
  },
];

// Three stages. The last one gets a dashed rail: past the near work the order
// is a guess and the site should say so.
const roadmap = [
  {
    label: "Completed",
    items: [
      "Layers, masks, mattes and blend modes",
      "Keyframes and the graph editor",
      "Sequence layers and the Retime system",
      "Optical-flow frame interpolation",
      "Beat detection and markers",
      "Over 100 GPU effects",
      "Presets, saved and shared",
      "2.5D camera and 3D layers",
      "Roto brush and Puppet",
      "Camera and planar tracking",
      "Text layers with animators",
      "Shape layers and paint",
      "Expressions",
      "The node graph",
      "OFX plugin hosting",
      "After Effects import, bundle and .aep",
      "Export queue with hardware encoding",
      "Proxies and background caching",
      "Autosave and crash recovery",
      "Windows, macOS and Linux builds",
    ],
  },
  {
    label: "In progress",
    items: [
      "The Audio workspace",
      "Custom shader nodes",
      "Colour management",
      "Tone mapping",
      "Interface performance at 60 and 120 fps",
    ],
  },
  {
    label: "Long run",
    dashed: true,
    items: [
      "Lumit's own effect format",
      "Lights and camera depth of field",
      "Particle simulator",
      "Scripting",
      "Blender scene import",
      "Lottie export",
      "OpenTimelineIO interchange",
      "Render-farm and command-line export",
    ],
  },
];
---

<Base
  title="Lumit"
  description="A native compositing and motion-graphics editor."
>
  {/* Everything below the hero starts hidden and is revealed by the script at
      the foot of this page. Without script the class is never set and the page
      is simply the page. */}
  <script is:inline>
    document.documentElement.classList.add("anim");
  </script>

  {/* ---------- hero ---------- */}
  <div class="relative -mt-16">
    <HeroField />
    <section class="relative flex min-h-[clamp(420px,54vh,560px)] flex-col items-center justify-center px-5 pt-24 pb-16 text-center">

      <h1 class="relative mb-0 w-[min(440px,78vw)]">
        <Wordmark />
        <span class="sr-only">Lumit - Compositing that adapts to your workflow.</span>
      </h1>

      {/* The hero arrives once the wordmark is home, and the download button
          leads: button, line, the two links under it. */}
      <p class="words relative mt-1 max-w-[640px] text-[17px] leading-[1.4] text-fg/80" data-reveal style="--base:150ms">
        {
          words.map((word, i) => (
            <Fragment>
              <span class="word" style={`--i:${i}`}>{word}</span>{" "}
            </Fragment>
          ))
        }
      </p>

      <div class="lead relative mt-7 flex flex-wrap items-center justify-center gap-3">
        <a class="btn border-white" href="/download" data-dl>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M8 2v9M4 7l4 4 4-4M2 13h12"></path>
          </svg>
          <span data-dl-label>Download</span>
        </a>
      </div>

      <p class="relative mt-2 text-[14px] text-fg-2" data-reveal style="--i:4">
        <a class="text-[13px] text-fg-2 no-underline hover:text-accent-2" href="/download" data-alt>
          All download options
        </a>
      </p>

      <script is:inline>
        (function () {
          var ua = navigator.userAgent;
          var os = /Win/.test(ua)
            ? "Windows"
            : /Mac/.test(ua)
              ? "macOS"
              : /Linux|X11/.test(ua)
                ? "Linux"
                : null;
          document.documentElement.dataset.os = os || "";
          if (!os) return;
          var others = {
            Windows: "Also for macOS and Linux",
            macOS: "Also for Windows and Linux",
            Linux: "Also for macOS and Windows",
          };
          var label = document.querySelector("[data-dl-label]");
          var alt = document.querySelector("[data-alt]");
          if (label) label.textContent = "Download for " + os;
          if (alt) alt.textContent = others[os];
        })();
      </script>

      <p class="relative mt-6 text-[17px] text-fg-2" data-reveal style="--i:6">
        Let your creativity flow. Free and open-source, forever.
      </p>
    </section>
  </div>

  {/* ---------- the product, in pictures ---------- */}
  <section id="features" class="wrap flex flex-col gap-10 pt-24 pb-20 sm:pt-[120px]">
    <div class="flex flex-col gap-3.5" data-reveal>
      <p class="kicker">Welcome to Lumit</p>
      <h2 class="text-[clamp(28px,3.4vw,36px)] leading-[1.1] text-fg-3">
        <span class="text-fg">Composite the way you know.</span>
      </h2>
    </div>

    {/* The one wide slot under the heading: the application on a real edit. A
        clip will take this place when one is recorded. */}
    <figure class="m-0 overflow-hidden rounded-card border border-line bg-ink-2" data-reveal style="--i:1">
      <Image
        class="block w-full"
        src={heroShot}
        alt="Lumit mid-edit: the viewer showing a graded frame, effect controls at the left, and a full timeline of layers and keyframes below"
        widths={[720, 1200, 1800]}
        sizes="(min-width: 1360px) 1200px, 100vw"
        loading="eager"
        fetchpriority="high"
        quality={90}
      />
    </figure>

    <div class="grid gap-10 md:grid-cols-2">
      {
        shots.map((s, i) => (
          <figure class="m-0 flex flex-col gap-2.5" data-reveal style={`--i:${i}`}>
            <Image
              class="block w-full rounded-card border border-line bg-ink-2"
              src={s.src}
              alt={s.alt}
              widths={[720, 1200, 1800]}
              sizes="(min-width: 1360px) 580px, (min-width: 768px) 46vw, 100vw"
              loading="lazy"
              quality={90}
            />
            <figcaption class="flex max-w-[620px] flex-col gap-2.5">
              <span class="font-mono text-[18px] tracking-[-0.01em] text-fg">{s.h}</span>
              <span class="text-[15px] leading-[1.35] text-fg-3">{s.p}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="flex flex-col gap-3.5" data-reveal>
      <h2 class="text-[clamp(28px,3.4vw,36px)] leading-[1.1] text-fg-3">
        <span class="text-fg"> Meet the interface. </span>
      </h2>
    </div>
    {/* Four names on one rule, and one picture under them - the drawing's own
        idea, and a good one: four slots side by side had to be small to fit,
        and the point of these is that you can see what is happening in them.
        One is always open, so the panel is never empty and the row never reads
        as four things you have not chosen yet. */}
    <div data-tabs data-reveal>
      <div
        class="flex items-baseline border-b border-line pb-3.5"
        role="tablist"
        aria-label="Meet the interface"
      >
        {
          tabs.map((c, i) => (
            <>
              {i > 0 && (
                <span class="px-4 text-[15px] text-fg-4" aria-hidden="true">
                  |
                </span>
              )}
              <button
                type="button"
                role="tab"
                id={`tab-${i}`}
                aria-controls={`panel-${i}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class="tab cursor-pointer border-0 bg-transparent p-0 font-mono text-[17px] text-fg-3"
              >
                {c.h}
              </button>
            </>
          ))
        }
      </div>
      {
        tabs.map((c, i) => (
          <div
            id={`panel-${i}`}
            role="tabpanel"
            aria-labelledby={`tab-${i}`}
            class="mt-6 overflow-hidden rounded-card border border-line bg-ink-2"
            hidden={i !== 0}
          >
            <Image
              class="block w-full"
              src={c.src}
              alt={c.alt}
              widths={[720, 1200, 1800]}
              sizes="(min-width: 1360px) 1200px, 100vw"
              loading="lazy"
              quality={90}
            />
          </div>
        ))
      }
    </div>
  </section>

  {/* ---------- why it exists ---------- */}
  <section class="border-t border-line py-20 sm:py-24">
    <div class="wrap">
      <div data-reveal>
        <p class="kicker">Why Lumit exists</p>
        <h2 class="mt-3.5 text-[clamp(28px,3.4vw,36px)] leading-[1.1]">
          Editing should not be a chore.
        </h2>
        <p class="mt-4 max-w-[620px] text-[15px] leading-[1.5] text-fg-3">
          Preview lag, interfaces that stop responding, and large external plugin suites
          that slow down your device. Lumit replaces all of this in a single application,
          with support for OFX plugins should you still require them.
        </p>
      </div>

      <div
        class="mt-12 grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2"
      >
        {
          features.map((f, i) => (
            <div class="bg-ink-2 p-7" data-reveal style={`--i:${i % 2}`}>
              <h3 class="font-mono text-[15px] text-fg">{f.h}</h3>
              <p class="mt-2.5 text-[15px] leading-[1.35] text-fg-3">{f.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- roadmap ---------- */}
  <section id="roadmap" class="border-t border-line bg-ink-2 py-20 sm:py-24">
    <div class="wrap">
      <div data-reveal>
        <p class="kicker">Roadmap</p>
        <h2 class="mt-3.5 text-[clamp(28px,3.4vw,36px)] leading-[1.1]">What we are building.</h2>
        <p class="mt-4 max-w-[620px] text-[15px] leading-[1.5] text-fg-3">
          Lumit is in public beta. Here is what is built, what is being worked on now, and
          what comes after.
        </p>
      </div>

      <div class="roadmap mt-14">
        {
          roadmap.map((stage, i) => (
            <div class:list={["stage", stage.dashed && "stage-open"]} data-reveal>
              <span class="marker" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="head">
                <h3 class="kicker">{stage.label}</h3>
              </div>
              <ul class="items">
                {stage.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- close ---------- */}
  <section class="border-t border-line py-20 text-center sm:py-24">
    <div class="wrap" data-reveal>
      <h2 class="text-[clamp(28px,3.4vw,36px)] leading-[1.1]">Free, forever.</h2>
      <p class="mx-auto mt-4 max-w-[620px] text-[15px] leading-[1.5] text-fg-3">
        Open source under GPLv3, and yours to keep. Windows, Linux and macOS builds are
        all ready now - no account, no licence key.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a class="btn" href="/download">Download Lumit</a>
        <a class="btn btn-ghost" href="https://docs.lumitlab.com">Read the docs</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Nothing marked for reveal is drawn until the script releases it - the
     wordmark coming home for the hero, scrolling into view for the rest. --i
     staggers the pieces of one group against each other, 70ms apart. */
  :global(html.anim) [data-reveal] {
    opacity: 0;
    filter: blur(10px);
    transform: translateY(12px);
  }
  :global(html.anim) [data-reveal].shown {
    opacity: 1;
    filter: blur(0);
    transform: none;
    transition:
      opacity 500ms ease-out calc(var(--i, 0) * 70ms),
      filter 500ms ease-out calc(var(--i, 0) * 70ms),
      transform 500ms ease-out calc(var(--i, 0) * 70ms);
  }

  /* The download button does not wait for the wordmark: it blurs in as the
     page loads, and the rest of the hero follows the lockup home. */
  :global(html.anim) .lead {
    animation: piece-in 500ms both;
  }
  @keyframes piece-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }

  /* The hero line is the one that arrives a word at a time, so the paragraph
     itself never blurs - its words do, each taking 500ms and starting 16ms
     after the one before it, the line as a whole starting at --base. */
  :global(html.anim) [data-reveal].words {
    opacity: 1;
    filter: none;
    transform: none;
    transition: none;
  }
  :global(html.anim) .words .word {
    opacity: 0;
  }
  :global(html.anim) .words.shown .word {
    animation: word-in 500ms both;
    animation-delay: calc(var(--base, 0ms) + var(--i) * 16ms);
  }
  .word {
    display: inline-block;
  }
  /* Both ends are written out. A keyframe list with no `to` takes the element's
     own style as its end, and a word's own style is the hidden one above - so
     an implicit end would animate it from invisible to invisible. */
  @keyframes word-in {
    from {
      opacity: 0;
      filter: blur(6px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.anim) [data-reveal],
    :global(html.anim) .lead,
    :global(html.anim) .words .word {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  /* The name of the panel you are looking at lifts a few pixels off the rule
     and takes the full text colour. It is the whole indicator - no underline,
     no box, nothing that needs a second colour - and it moves rather than
     changes size, so the row's own width never shifts as you switch. */
  .tab {
    transition:
      color 0.15s,
      transform 0.15s;
  }
  .tab:hover {
    color: var(--color-fg-2);
  }
  .tab[aria-selected="true"] {
    color: var(--color-fg);
    transform: translateY(-4px);
  }

  /* Numbered stages against a rail. Each stage carries its own rail segment so
     the last one can go dashed: past the near work the order is a guess, and
     the line should look like one. */
  .stage {
    position: relative;
    display: grid;
    gap: 20px;
    padding: 0 0 44px 44px;
    border-left: 1px solid var(--color-line-2);
  }
  .stage-open {
    border-left-style: dashed;
  }
  .stage:last-child {
    padding-bottom: 0;
  }
  .marker {
    position: absolute;
    left: 0;
    top: -2px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-left: -14px;
    border-radius: var(--radius-ctl);
    border: 1px solid var(--color-line-2);
    background: var(--color-ink-2);
    color: var(--color-fg-3);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
  }
  /* Each item is its own cell. A shared grid with hairline gaps left the empty
     cells of a partial last row showing as a grey block, and no item count fixes
     that while the columns are responsive. */
  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .items li {
    padding: 8px 14px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-ctl);
    background: var(--color-ink);
    color: var(--color-fg-2);
    font-size: 14px;
    line-height: 1.35;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .items li:hover {
    color: var(--color-fg);
    border-color: var(--color-line-2);
  }
  @media (min-width: 768px) {
    .stage {
      grid-template-columns: minmax(0, 210px) minmax(0, 1fr);
      gap: 40px;
      padding-bottom: 52px;
    }
  }
</style>

<script>
  // Point the hero button straight at the installer for the visitor's platform.
  // Pure enhancement: the button ships pointing at /download, and every failure
  // here leaves it be. The button's *words* are set inline in the hero instead,
  // because changing them after this module loads would move the layout.
  //
  // No platform is "coming": release.yml builds a Windows .exe, a macOS .dmg
  // and a Linux .flatpak on every tag and every job gates the release (K-304),
  // so all three exist whenever any of them does.
  const ASSET: Record<string, RegExp> = {
    Windows: /windows.*\.exe$/i,
    Linux: /linux.*\.flatpak$/i,
    macOS: /\.dmg$/i,
  };
  // The inline script in the hero has already worked the platform out.
  const os = document.documentElement.dataset.os;

  const btn = document.querySelector<HTMLAnchorElement>("[data-dl]");

  type Asset = { name: string; browser_download_url: string };
  if (os && btn && ASSET[os]) {
    const want = ASSET[os];
    fetch("https://api.github.com/repos/luminalmvm/Lumit/releases/latest")
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json() as Promise<{ assets: Asset[] }>;
      })
      .then((rel) => {
        const asset = rel.assets.find((a) => want.test(a.name));
        if (asset) btn.href = asset.browser_download_url;
      })
      .catch(() => {
        /* the shipped /download link stands */
      });
  }

  // Meet the interface: one panel open at a time, and always one. Clicking a
  // name opens its panel; the arrow keys walk the row, which is what a tablist
  // is expected to do and is four lines here.
  const tabsRoot = document.querySelector<HTMLElement>("[data-tabs]");
  if (tabsRoot) {
    const tabs = [...tabsRoot.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...tabsRoot.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    const open = (want: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === want;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[want].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => open(i));
      tab.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        open((i + step + tabs.length) % tabs.length, true);
      });
    });
  }

  // The page below the hero arrives once the wordmark has come home - the same
  // cue the hero's own background waits for - and then a group at a time as it
  // scrolls into view. The timeout is the safety net for a wordmark that never
  // animates.
  const reveal = () => {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("shown");
          seen.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px" },
    );
    for (const el of document.querySelectorAll("[data-reveal]")) seen.observe(el);
  };

  let revealed = false;
  const once = () => {
    if (revealed) return;
    revealed = true;
    reveal();
  };
  // A visit that lands part-way down the page - an anchor from the header, a
  // restored scroll position - has no hero animation to wait for.
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) once();
  else if (location.hash || scrollY > 0) once();
  else {
    document.addEventListener("wordmark:home", once, { once: true });
    setTimeout(once, 1800);
  }
</script>
