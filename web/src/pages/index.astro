---
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";

// Each feature can carry a short clip in /public/clips/. Missing files are fine:
// the media block removes itself if the video fails to load.
const features = [
  {
    h: "Playback is the product",
    p: "Rendering runs on the GPU. Lumit reuses cached work and lowers preview quality when it needs to, so the interface stays responsive - even during export.",
    clip: "/clips/playback.webm",
  },
  {
    h: "One retime, two choices",
    p: "Retime has two views of the same data. Use the value graph if you work like After Effects, or the speed graph and Sequence layers if you cut like Vegas. Switch whenever you need.",
    clip: "/clips/retime.webm",
  },
  {
    h: "Cut like an NLE, inside a layer",
    p: "Sequence layers hold a run of clips cut back-to-back on one row - cutting and per-clip retiming, living inside the composition's layer stack.",
    clip: "/clips/sequence.webm",
  },
  {
    h: "A graph editor worth living in",
    p: "Value and speed views of the same curves, AE-compatible bezier maths, and easing built to be judged by feel.",
    clip: "/clips/graph.webm",
  },
  {
    h: "The effects you actually use",
    p: "Eighty-five of them ship, built in and GPU-rendered: glow, motion blur, camera shake, RGB split, smooth zoom, and a grading suite with a LUT loader. Every one has a page in the manual showing what it does. OFX hosting is on the roadmap.",
    clip: "/clips/effects.webm",
  },
  {
    h: "Bring your After Effects projects",
    p: "A free panel runs inside After Effects and writes a bundle Lumit opens. Keyframes carry across value for value, and an import report says what was adjusted on the way and what could not come at all.",
  },
  {
    h: "Your work survives the crash",
    p: "Every edit goes through an operation journal, and the project autosaves beside it. Kill Lumit mid-edit and it offers the recovered project on the next launch.",
  },
  {
    h: "Open source, GPLv3",
    p: "The whole engine and interface, in the open. No subscription, no per-seat licence, and no plugin tax on the basics.",
  },
];

// Three numbered stages. The stage after 1.0 gets a dashed rail: past the
// release, the order is a guess and the site should say so.
const roadmap = [
  {
    label: "Currently in-progress",
    items: [
      "After Effects import",
      "Expressions",
      "Optical-flow retiming",
      "Beat detection and snapping",
      "Motion paths in the Viewer",
      "Shape modifiers and path editing",
      "The macOS pass",
    ],
  },
  {
    label: "Before 1.0",
    items: [
      "Export queue",
      "Tone mapping",
      "GPU scopes",
      "Proxy generation",
      "First-run setup",
      "Signed installers",
    ],
  },
  {
    label: "After 1.0",
    dashed: true,
    items: [
      "OFX plugin hosting",
      "3D lights and camera depth of field",
      "Tracker and stabiliser",
      "Rotoscoping",
      "Variable-width mask feather",
      "Particles",
      "Text animators",
      "Audio panel and level meters",
      "Composer audio workspace",
      "Node view",
      "Scripting",
      "Colour management",
    ],
  },
];
---

<Base
  title="Lumit"
  description="A native compositing and motion-graphics editor. GPU-first, open source, and built to stay responsive with thousands of layers."
>
  {/* ---------- hero ---------- */}
  <div class="relative overflow-hidden py-16 sm:py-24 lg:py-32">
    <div
      class="pointer-events-none absolute left-1/2 top-[-30%] aspect-square w-[min(1100px,130vw)] -translate-x-1/2"
      style="background: radial-gradient(closest-side, rgb(138 112 255 / 0.16), rgb(134 226 255 / 0.07) 45%, transparent 72%)"
      aria-hidden="true"
    >
    </div>
    <div class="wrap relative">
      {/* Centred on mobile: the wordmark's launch swings well left of its own
          box, and only symmetric margin keeps that excursion on screen. */}
      <div class="flex flex-col items-center sm:items-start">
        <Wordmark class="mb-9 w-[min(340px,68vw)]" />
        <a class="pill" href="/download">
          <span class="h-1.5 w-1.5 rounded-full bg-key-cy"></span>
          <b class="font-medium text-fg" data-ver>v0.2.0</b> - public beta
        </a>
      </div>
      <h1
        class="mt-6 max-w-[15ch] text-[clamp(38px,6.4vw,72px)] leading-[1.02] tracking-[-0.042em]"
      >
        Compositing, your way.
      </h1>
      <p class="mt-6 max-w-[56ch] text-[clamp(16px,2vw,18.5px)] leading-relaxed">
        A native compositing and motion-graphics editor, built for editors.
        GPU-first, open source, and responsive in projects with thousands of layers.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="btn" href="/download" data-dl>Download</a>
        <a class="btn btn-ghost" href="https://github.com/luminalmvm/Lumit">
          <svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path
              d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"
            ></path>
          </svg>
          Source
        </a>
      </div>
      <p class="mt-4 text-[13.5px]">
        <a href="/download" class="text-fg-2 underline underline-offset-2 hover:text-fg">
          View all download options</a
        >
      </p>
      <p class="mt-2 text-[13.5px] text-fg-3" data-platnote>
        Windows, Linux, and macOS · GPLv3 · free forever
      </p>
    </div>
  </div>

  {/* ---------- features ---------- */}
  <section id="features" class="border-t border-line py-16 sm:py-24">
    <div class="wrap">
      <p class="kicker">Why Lumit exists</p>
      <h2 class="mt-4 text-[clamp(26px,3.6vw,40px)] leading-[1.1]">
        Editing should not be a chore.
      </h2>
      <p class="mt-4 max-w-[620px]">
        Preview lag, interfaces that stop responding, and large external plugin suites
        that slow down your device. Lumit replaces all of this in a single application,
        with support for OFX plugins should you still require them.
      </p>

      <div
        class="mt-12 grid gap-px overflow-hidden rounded-[14px] border border-line bg-line sm:grid-cols-2"
      >
        {
          features.map((f) => (
            <div class="bg-ink p-7">
              {f.clip && (
                <div class="feature-media relative mb-5 overflow-hidden rounded-[10px] border border-line bg-ink-2">
                  <video
                    class="block aspect-video w-full object-cover"
                    src={f.clip}
                    muted
                    loop
                    playsinline
                    preload="metadata"
                  />
                  <span
                    class="pointer-events-none absolute bottom-2 right-2 rounded-full border border-line bg-ink/80 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.12em] text-fg-3 transition-opacity"
                    data-hint
                  >
                    Hover to play
                  </span>
                </div>
              )}
              <h3 class="text-[18px] tracking-[-0.02em]">{f.h}</h3>
              <p class="mt-2.5 text-[15px]">{f.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- roadmap ---------- */}
  <section id="roadmap" class="border-t border-line bg-ink-2 py-16 sm:py-24">
    <div class="wrap">
      <p class="kicker">Roadmap</p>
      <h2 class="mt-4 text-[clamp(26px,3.6vw,40px)] leading-[1.1]">What we are building.</h2>
      <p class="mt-4 max-w-[620px]">
        Lumit is in public beta. Here are the current in-progress features, and a
        preview of what's to come.
      </p>

      <div class="roadmap mt-14">
        {
          roadmap.map((stage, i) => (
            <div class:list={["stage", stage.dashed && "stage-open"]}>
              <span class="marker" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="head">
                <h3 class="kicker">{stage.label}</h3>
              </div>
              <ul class="items">
                {stage.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- close ---------- */}
  <section class="border-t border-line py-16 text-center sm:py-24">
    <div class="wrap">
      <h2 class="text-[clamp(26px,3.6vw,40px)] leading-[1.1]">Free, forever.</h2>
      <p class="mx-auto mt-4 max-w-[620px]">
        Open source under GPLv3, and yours to keep. Windows, Linux and macOS builds are
        all ready now - no account, no licence key.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a class="btn" href="/download">Download Lumit</a>
        <a class="btn btn-ghost" href="https://docs.lumitlab.com">Read the docs</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Numbered stages against a rail. Each stage carries its own rail segment so
     the last one can go dashed: past 1.0 the order is a guess, and the line
     should look like one. The item cells reuse the feature grid's hairlines. */
  .stage {
    position: relative;
    display: grid;
    gap: 20px;
    padding: 0 0 44px 44px;
    border-left: 1px solid var(--color-line-2);
  }
  .stage-open {
    border-left-style: dashed;
  }
  .stage:last-child {
    padding-bottom: 0;
  }
  .marker {
    position: absolute;
    left: 0;
    top: -2px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-left: -14px;
    border-radius: 7px;
    border: 1px solid var(--color-line-2);
    background: var(--color-ink);
    color: var(--color-fg-3);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
  }
  /* Each item is its own bubble. A shared grid with hairline gaps left the
     empty cells of a partial last row showing as a grey block, and no item
     count fixes that while the columns are responsive. */
  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .items li {
    padding: 10px 15px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-fg-2);
    font-size: 14px;
    line-height: 1.35;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .items li:hover {
    color: var(--color-fg);
    border-color: var(--color-line-2);
  }
  @media (min-width: 768px) {
    .stage {
      grid-template-columns: minmax(0, 210px) minmax(0, 1fr);
      gap: 40px;
      padding-bottom: 52px;
    }
  }
</style>

<script>
  // Name the visitor's OS on the hero button and point it straight at that
  // platform's installer, and let the version pill say whatever the latest
  // GitHub release says. Pure enhancement: the button ships pointing at
  // /download and the pill ships with the version current at deploy time,
  // and every failure here leaves them be. "View all download options"
  // underneath is the route for everyone else.
  const ASSET: Record<string, RegExp> = {
    Windows: /windows.*\.exe$/i,
    Linux: /linux.*\.flatpak$/i,
    macOS: /\.dmg$/i,
  };

  const ua = navigator.userAgent;
  const os = /Win/.test(ua)
    ? "Windows"
    : /Mac/.test(ua)
      ? "macOS"
      : /Linux|X11/.test(ua)
        ? "Linux"
        : null;

  const btn = document.querySelector<HTMLAnchorElement>("[data-dl]");
  const ver = document.querySelector("[data-ver]");

  if (os && btn) btn.textContent = `Download for ${os}`;

  type Asset = { name: string; browser_download_url: string };
  fetch("https://api.github.com/repos/luminalmvm/Lumit/releases/latest")
    .then((r) => {
      if (!r.ok) throw new Error(String(r.status));
      return r.json() as Promise<{ tag_name: string; assets: Asset[] }>;
    })
    .then((rel) => {
      if (ver && rel.tag_name) ver.textContent = rel.tag_name;
      if (os && btn) {
        const asset = rel.assets.find((a) => ASSET[os].test(a.name));
        if (asset) btn.href = asset.browser_download_url;
      }
    })
    .catch(() => {
      /* the shipped pill and /download link stand */
    });

  // Feature clips play on hover. A clip that fails to load takes its whole media
  // block with it, so cards degrade to plain text until the file exists.
  for (const media of document.querySelectorAll<HTMLElement>(".feature-media")) {
    const video = media.querySelector("video");
    if (!video) continue;
    video.addEventListener("error", () => media.remove());
    if (video.error) {
      media.remove();
      continue;
    }
    const hint = media.querySelector("[data-hint]");
    media.addEventListener("mouseenter", () => {
      video.play().catch(() => {});
      hint?.classList.add("opacity-0");
    });
    media.addEventListener("mouseleave", () => {
      video.pause();
      hint?.classList.remove("opacity-0");
    });
  }
</script>
