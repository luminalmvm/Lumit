---
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";
import HeroField from "../components/HeroField.astro";
import HeroTimeline from "../components/HeroTimeline.astro";
import Showcase from "../components/home/Showcase.astro";
import Workspaces from "../components/home/Workspaces.astro";
import Stories from "../components/home/Stories.astro";
import Features from "../components/home/Features.astro";
import Roadmap from "../components/home/Roadmap.astro";
import Closing from "../components/home/Closing.astro";

// The hero line arrives a word at a time. One span per word, each carrying its
// own index; the delay is arithmetic in CSS rather than script.
const tagline =
  "Compositing that adapts to your workflow. Built by editors, for editors. With an application that always remains responsive.";
const words = tagline.split(" ");
---

<Base
  title="Lumit"
  description="A native compositing and motion-graphics editor."
>
  {/* Everything below the hero starts hidden and is revealed by the script at
      the foot of this page. Without script the class is never set and the page
      is simply the page. */}
  <script is:inline>
    document.documentElement.classList.add("anim");
  </script>

  {/* ---------- hero ---------- */}
  <div class="relative -mt-16">
    <HeroField />
    <section class="relative flex min-h-[clamp(420px,54vh,560px)] flex-col items-center justify-center px-5 pt-24 pb-16 text-center">

      <h1 class="relative mb-0 w-[min(440px,78vw)]">
        <Wordmark controlled />
        <span class="sr-only">Lumit - Compositing that adapts to your workflow.</span>
      </h1>

      {/* The hero arrives once the wordmark is home, and the download button
          leads: button, line, the two links under it. */}
      <p class="words relative mt-1 max-w-[640px] text-[17px] leading-[1.4] text-fg/80" data-reveal style="--base:150ms">
        {
          words.map((word, i) => (
            <Fragment>
              <span class="word" style={`--i:${i}`}>{word}</span>{" "}
            </Fragment>
          ))
        }
      </p>

      <div class="lead relative mt-7 flex flex-wrap items-center justify-center gap-3">
        <a class="btn border-white" href="/download" data-dl>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M8 2v9M4 7l4 4 4-4M2 13h12"></path>
          </svg>
          <span data-dl-label>Download</span>
        </a>
      </div>

      <p class="relative mt-2 text-[14px] text-fg-2" data-reveal style="--i:4">
        <a class="text-[13px] text-fg-2 no-underline hover:text-accent-2" href="/download" data-alt>
          All download options
        </a>
      </p>

      <script is:inline>
        (function () {
          var ua = navigator.userAgent;
          // A phone or tablet has no installer to be offered. An iPhone says
          // "like Mac OS X", Android says "Linux", and an iPad says it is a
          // Mac outright, so those are ruled out before the desktop names.
          var handheld =
            /Android|iPhone|iPad|iPod/.test(ua) ||
            (/Mac/.test(ua) && navigator.maxTouchPoints > 1);
          var os = handheld
            ? null
            : /Win/.test(ua)
              ? "Windows"
              : /Mac/.test(ua)
                ? "macOS"
                : /Linux|X11/.test(ua)
                  ? "Linux"
                  : null;
          document.documentElement.dataset.os = os || "";
          if (handheld) {
            var note = document.querySelector("[data-alt]");
            if (note) note.textContent = "For Windows, macOS and Linux";
          }
          if (!os) return;
          var others = {
            Windows: "Also for macOS and Linux",
            macOS: "Also for Windows and Linux",
            Linux: "Also for macOS and Windows",
          };
          var label = document.querySelector("[data-dl-label]");
          var alt = document.querySelector("[data-alt]");
          if (label) label.textContent = "Download for " + os;
          if (alt) alt.textContent = others[os];
        })();
      </script>

      <p class="relative mt-6 text-[17px] text-fg-2" data-reveal style="--i:6">
        Let your creativity flow. Free and open-source, forever.
      </p>

      {/* The hero is a composition, and this is its timeline: what is above is
          drawn from these keyframes, and a visitor can move them. */}
      <div class="relative mt-12 flex w-full justify-center" data-reveal style="--i:8">
        <HeroTimeline />
      </div>
    </section>
  </div>

  {/* ---------- the page below the hero, a section to a component ---------- */}
  <Showcase />
  <Workspaces />
  <Stories />
  <Features />
  <Roadmap />
  <Closing />

  {/* ---------- a screenshot, brought forward ---------- */}
  <dialog class="lightbox" data-lightbox aria-label="Screenshot, enlarged">
    <div class="veil" data-veil></div>
    <img data-full alt="" draggable="false" />
  </dialog>

  {/* What the page behind is put through while a screenshot is forward: a
      lens blur, not a Gaussian one. Each of the four stages averages two
      copies of the picture pushed apart along one direction, and four
      directions 45 degrees apart leave sixteen copies on two rings - the
      shape a point of light takes through an out-of-focus lens, where a
      Gaussian would only make a soft dot. The small blur first fills in
      between the copies. The script sets every distance, so the blur can
      open up and close down. Units are CSS pixels. */}
  <svg class="lens-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="lens" color-interpolation-filters="sRGB">
      <feGaussianBlur in="SourceGraphic" stdDeviation="0" data-lens-soft result="s"></feGaussianBlur>
      <feOffset in="s" data-lens="1 0" result="a1"></feOffset>
      <feOffset in="s" data-lens="-1 0" result="a2"></feOffset>
      <feComposite in="a1" in2="a2" operator="arithmetic" k1="0" k2="0.5" k3="0.5" k4="0" result="a"></feComposite>
      <feOffset in="a" data-lens="0 1" result="b1"></feOffset>
      <feOffset in="a" data-lens="0 -1" result="b2"></feOffset>
      <feComposite in="b1" in2="b2" operator="arithmetic" k1="0" k2="0.5" k3="0.5" k4="0" result="b"></feComposite>
      <feOffset in="b" data-lens="0.7071 0.7071" result="c1"></feOffset>
      <feOffset in="b" data-lens="-0.7071 -0.7071" result="c2"></feOffset>
      <feComposite in="c1" in2="c2" operator="arithmetic" k1="0" k2="0.5" k3="0.5" k4="0" result="c"></feComposite>
      <feOffset in="c" data-lens="0.7071 -0.7071" result="d1"></feOffset>
      <feOffset in="c" data-lens="-0.7071 0.7071" result="d2"></feOffset>
      <feComposite in="d1" in2="d2" operator="arithmetic" k1="0" k2="0.5" k3="0.5" k4="0"></feComposite>
    </filter>
  </svg>
</Base>

<style>
  /* The download button does not wait for the wordmark: it blurs in as the
     page loads, and the rest of the hero follows the lockup home. */
  :global(html.anim) .lead {
    animation: piece-in 500ms both;
  }
  @keyframes piece-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  /* The hero line is the one that arrives a word at a time, so the paragraph
     itself never blurs - its words do, each taking 500ms and starting 16ms
     after the one before it, the line as a whole starting at --base. */
  :global(html.anim) [data-reveal].words {
    opacity: 1;
    filter: none;
    transform: none;
    transition: none;
  }
  :global(html.anim) .words .word {
    opacity: 0;
  }
  :global(html.anim) .words.shown .word {
    animation: word-in 500ms both;
    animation-delay: calc(var(--base, 0ms) + var(--i) * 16ms);
  }
  .word {
    display: inline-block;
  }
  /* Both ends are written out. A keyframe list with no `to` takes the element's
     own style as its end, and a word's own style is the hidden one above - so
     an implicit end would animate it from invisible to invisible. */
  @keyframes word-in {
    from {
      opacity: 0;
      filter: blur(6px);
    }
    to {
      opacity: 1;
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.anim) .lead,
    :global(html.anim) .words .word {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  /* The screenshot brought forward. The dialog is the whole window and draws
     nothing itself: the veil dims the page and lays the hero's grain over it,
     the page behind is out of focus (the lens filter, set from the script),
     and the picture is placed and moved by the script. */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: none;
    outline: none;
  }
  .lightbox::backdrop {
    background: none;
  }
  .veil {
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, var(--color-ink) 38%, transparent);
    background-image: var(--grain, none);
    background-size: 256px 256px;
    opacity: 0;
    transition: opacity 300ms ease-out;
  }
  .lightbox.open .veil {
    opacity: 1;
  }
  .lightbox img {
    position: absolute;
    display: block;
    max-width: none;
    border: 1px solid var(--color-line-2);
    border-radius: var(--radius-card);
    box-shadow: 0 30px 90px rgb(0 0 0 / 0.55);
    transform-origin: 0 0;
    will-change: transform;
    cursor: pointer;
    user-select: none;
  }
</style>

<style is:global>
  /* The page behind a screenshot that has come forward. Global, since the bar
     and the footer are not this page's own elements. */
  html.lens body > header,
  html.lens body > main,
  html.lens body > footer {
    filter: url(#lens);
  }
</style>

<script>
  import { hero } from "../scripts/hero-state";

  // Point the download buttons straight at the installer for the visitor's
  // platform. Pure enhancement: each ships pointing at /download, and every
  // failure here leaves it be. A button's *words* are set inline beside it
  // instead, because changing them after this module loads would move the layout.
  //
  // No platform is "coming": release.yml builds a Windows .exe, a macOS .dmg
  // and a Linux .flatpak on every tag and every job gates the release,
  // so all three exist whenever any of them does.
  const ASSET: Record<string, RegExp> = {
    Windows: /windows.*\.exe$/i,
    Linux: /linux.*\.flatpak$/i,
    macOS: /\.dmg$/i,
  };
  // The inline script in the hero has already worked the platform out.
  const os = document.documentElement.dataset.os;

  const btns = document.querySelectorAll<HTMLAnchorElement>("[data-dl]");

  type Asset = { name: string; browser_download_url: string };
  if (os && btns.length && ASSET[os]) {
    const want = ASSET[os];
    fetch("https://api.github.com/repos/luminalmvm/Lumit/releases/latest")
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json() as Promise<{ assets: Asset[] }>;
      })
      .then((rel) => {
        const asset = rel.assets.find((a) => want.test(a.name));
        if (asset) for (const btn of btns) btn.href = asset.browser_download_url;
      })
      .catch(() => {
        /* the shipped /download link stands */
      });
  }

  // Meet the interface: one panel open at a time, and always one. Clicking a
  // name opens its panel; the arrow keys walk the row, which is what a tablist
  // is expected to do and is four lines here.
  const tabsRoot = document.querySelector<HTMLElement>("[data-tabs]");
  if (tabsRoot) {
    const tabs = [...tabsRoot.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...tabsRoot.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    const open = (want: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === want;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[want].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => open(i));
      tab.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        open((i + step + tabs.length) % tabs.length, true);
      });
    });
  }

  // A screenshot comes forward from where it sits on the page, with a little
  // spring, to something short of the whole window. The page behind goes out
  // of focus and takes the hero's grain. A click anywhere, Escape, or a
  // scroll sends it back to its place.
  const box = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  if (box) {
    const full = box.querySelector<HTMLImageElement>("[data-full]")!;
    const root = document.documentElement;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    // Out of <main>, which is one of the things the lens filter is put on.
    document.body.append(box);

    // ---- the lens ----
    const soft = document.querySelector<SVGElement>("[data-lens-soft]")!;
    const offsets = [...document.querySelectorAll<SVGElement>("[data-lens]")].map((el) => {
      const [x, y] = el.dataset.lens!.split(" ").map(Number);
      return { el, x, y };
    });
    const REACH = 6; // each stage pushes its two copies this far apart, each way
    let lens = 0;
    let lensRun = 0;
    const setLens = (k: number) => {
      lens = k;
      soft.setAttribute("stdDeviation", (3.2 * k).toFixed(2));
      for (const o of offsets) {
        o.el.setAttribute("dx", (o.x * REACH * k).toFixed(2));
        o.el.setAttribute("dy", (o.y * REACH * k).toFixed(2));
      }
      root.classList.toggle("lens", k > 0);
    };
    const focusTo = (to: number, ms: number) => {
      const run = ++lensRun;
      const from = lens;
      const t0 = performance.now();
      const step = (now: number) => {
        if (run !== lensRun) return;
        const x = still ? 1 : Math.min(1, (now - t0) / ms);
        setLens(from + (to - from) * (1 - Math.pow(1 - x, 3)));
        if (x < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    // ---- the grain ----
    // The hero field's own grain (HeroField.astro, `phash`), a screen pixel at
    // a time, as a tile: white where it would add and black where it would
    // take away, each as faint as the amount.
    const grain = () => {
      const dpr = Math.min(2, devicePixelRatio || 1);
      const n = Math.round(256 * dpr);
      const tile = document.createElement("canvas");
      tile.width = tile.height = n;
      const ctx = tile.getContext("2d");
      if (!ctx) return;
      const img = ctx.createImageData(n, n);
      const fract = (v: number) => v - Math.floor(v);
      for (let y = 0; y < n; y++) {
        for (let x = 0; x < n; x++) {
          let qx = fract(x * 0.1031);
          let qy = fract(y * 0.1031);
          let qz = qx;
          const d = qx * (qy + 33.33) + qy * (qz + 33.33) + qz * (qx + 33.33);
          qx += d;
          qy += d;
          qz += d;
          const v = (fract((qx + qy) * qz) - 0.5) * 0.036 * 1.5;
          const i = (y * n + x) * 4;
          img.data[i] = img.data[i + 1] = img.data[i + 2] = v > 0 ? 255 : 0;
          img.data[i + 3] = Math.round(Math.abs(v) * 255);
        }
      }
      ctx.putImageData(img, 0, 0);
      box.style.setProperty("--grain", `url(${tile.toDataURL()})`);
    };
    let grained = false;

    // ---- the picture ----
    type Box = { left: number; top: number; width: number; height: number };
    let thumb: HTMLImageElement | null = null;
    let clip: HTMLElement | null = null;
    let home: Box = { left: 0, top: 0, width: 1, height: 1 };
    let closing = false;

    // Where a box is, said as a transform of the picture's forward place.
    const from = (r: Box, x = 1) =>
      `translate(${((r.left - home.left) * x).toFixed(2)}px, ${((r.top - home.top) * x).toFixed(2)}px) ` +
      `scale(${(1 + (r.width / home.width - 1) * x).toFixed(4)})`;
    // A spring that overshoots by about a fifteenth and has settled by 640ms.
    const spring = (time: number) => {
      const z = 0.64;
      const w = 13;
      const wd = w * Math.sqrt(1 - z * z);
      return 1 - Math.exp(-z * w * time) * (Math.cos(wd * time) + ((z * w) / wd) * Math.sin(wd * time));
    };

    const open = (shot: HTMLButtonElement) => {
      const small = shot.querySelector("img");
      if (!small || box.open) return;
      thumb = small;
      closing = false;
      if (!grained) {
        grained = true;
        grain();
      }

      const url = shot.dataset.zoom!;
      const w = Number(shot.dataset.w);
      const h = Number(shot.dataset.h);
      full.alt = small.alt;
      full.src = small.currentSrc || url;
      full.dataset.want = url;
      const big = new Image();
      big.onload = () => {
        if (box.open && full.dataset.want === url) full.src = url;
      };
      big.src = url;

      // Forward is most of the window and never all of it, and never bigger
      // than the capture itself.
      const phone = innerWidth < 640;
      const width = Math.min(innerWidth * (phone ? 0.94 : 0.84), (innerHeight * 0.8 * w) / h, w);
      const height = (width * h) / w;
      home = { left: (innerWidth - width) / 2, top: (innerHeight - height) / 2, width, height };
      full.style.left = `${home.left}px`;
      full.style.top = `${home.top}px`;
      full.style.width = `${width}px`;
      full.style.height = `${height}px`;

      const start = small.getBoundingClientRect();
      box.showModal();
      box.classList.add("open");
      small.style.visibility = "hidden";
      // A card's clip lies over its picture, and goes with it.
      clip = shot.querySelector<HTMLElement>("[data-clip]");
      if (clip) clip.style.visibility = "hidden";
      hero.paused = true;
      focusTo(1, 280);

      const frames: Keyframe[] = [];
      const STEPS = 40;
      for (let i = 0; i <= STEPS; i++) {
        frames.push({ transform: from(start, 1 - spring((i / STEPS) * 0.64)) });
      }
      frames[STEPS] = { transform: "none" };
      full.animate(frames, { duration: still ? 1 : 640, easing: "linear" });
      addEventListener("scroll", close, { passive: true, once: true });
      addEventListener("resize", close, { once: true });
    };

    function close() {
      if (!box!.open || closing) return;
      closing = true;
      removeEventListener("scroll", close);
      removeEventListener("resize", close);
      // From wherever it has got to, back to where the page has it now.
      const now = full.getBoundingClientRect();
      full.getAnimations().forEach((a) => a.cancel());
      const back = thumb ? thumb.getBoundingClientRect() : now;
      box!.classList.remove("open");
      focusTo(0, 260);
      const going = full.animate(
        [{ transform: from(now) }, { transform: from(back) }],
        { duration: still ? 1 : 340, easing: "cubic-bezier(0.3, 0, 0.2, 1)", fill: "forwards" },
      );
      going.onfinish = () => {
        if (thumb) thumb.style.visibility = "";
        if (clip) clip.style.visibility = "";
        box!.close();
        going.cancel();
        setLens(0);
        hero.paused = false;
        closing = false;
      };
    }

    for (const shot of document.querySelectorAll<HTMLButtonElement>("[data-zoom]")) {
      shot.addEventListener("click", () => open(shot));
    }
    box.addEventListener("click", close);
    // Escape closes a dialog at once, and this one has a way back to take.
    box.addEventListener("cancel", (e) => {
      e.preventDefault();
      close();
    });
  }

  // The page below the hero arrives once the wordmark has come home - the same
  // cue the hero's own background waits for - and then a group at a time as it
  // scrolls into view. The timeout is the safety net for a wordmark that never
  // animates.
  const reveal = () => {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("shown");
          seen.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px" },
    );
    for (const el of document.querySelectorAll("[data-reveal]")) seen.observe(el);
  };

  let revealed = false;
  const once = () => {
    if (revealed) return;
    revealed = true;
    reveal();
  };
  // A visit that lands part-way down the page - an anchor from the header, a
  // restored scroll position - has no hero animation to wait for.
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) once();
  else if (location.hash || scrollY > 0) once();
  else {
    document.addEventListener("wordmark:home", once, { once: true });
    setTimeout(once, 1800);
  }
</script>
