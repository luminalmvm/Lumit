---
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";
import HeroField from "../components/HeroField.astro";
import HeroTimeline from "../components/HeroTimeline.astro";
import Showcase from "../components/home/Showcase.astro";
import Workspaces from "../components/home/Workspaces.astro";
import Together from "../components/home/Together.astro";
import Stories from "../components/home/Stories.astro";
import Features from "../components/home/Features.astro";
import Roadmap from "../components/home/Roadmap.astro";
import Closing from "../components/home/Closing.astro";

---

<Base
  title="Lumit"
  description="A native compositing and motion-graphics editor."
>
  {/* Everything below the hero starts hidden and is revealed by the script at
      the foot of this page. Without script the class is never set and the page
      is simply the page. */}
  <script is:inline>
    document.documentElement.classList.add("anim");
  </script>

  {/* ---------- hero ---------- */}
  <div class="relative -mt-16">
    <HeroField />
    <section class="relative flex min-h-[clamp(420px,54vh,560px)] flex-col items-center justify-center px-5 pt-24 pb-16 text-center">

      <h1 class="relative mb-0 w-[min(440px,78vw)]">
        <Wordmark controlled />
        <span class="sr-only">Lumit - Compositing that adapts to your workflow.</span>
      </h1>

      {/* The download button leads, then the line and the link under it. */}
      <p class="relative mt-1 max-w-[640px] text-[17px] leading-[1.4] text-fg/80" data-reveal style="--i:2">
        Compositing that adapts to your workflow. Built by editors, for editors. With an application that always remains responsive.
      </p>

      <div class="lead relative mt-7 flex flex-wrap items-center justify-center gap-3">
        <a class="btn btn-solid" href="/download" data-dl>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M8 2v9M4 7l4 4 4-4M2 13h12"></path>
          </svg>
          <span data-dl-label>Download</span>
        </a>
      </div>

      <p class="relative mt-2 text-[14px] text-fg-2" data-reveal style="--i:4">
        <a class="text-[13px] text-fg-2 no-underline hover:text-accent-2" href="/download" data-alt>
          All download options
        </a>
      </p>

      <script is:inline>
        (function () {
          var ua = navigator.userAgent;
          // A phone or tablet has no installer to be offered. An iPhone says
          // "like Mac OS X", Android says "Linux", and an iPad says it is a
          // Mac outright, so those are ruled out before the desktop names.
          var handheld =
            /Android|iPhone|iPad|iPod/.test(ua) ||
            (/Mac/.test(ua) && navigator.maxTouchPoints > 1);
          var os = handheld
            ? null
            : /Win/.test(ua)
              ? "Windows"
              : /Mac/.test(ua)
                ? "macOS"
                : /Linux|X11/.test(ua)
                  ? "Linux"
                  : null;
          document.documentElement.dataset.os = os || "";
          if (handheld) {
            var note = document.querySelector("[data-alt]");
            if (note) note.textContent = "For Windows, macOS and Linux";
          }
          if (!os) return;
          var others = {
            Windows: "Also for macOS and Linux",
            macOS: "Also for Windows and Linux",
            Linux: "Also for macOS and Windows",
          };
          var label = document.querySelector("[data-dl-label]");
          var alt = document.querySelector("[data-alt]");
          if (label) label.textContent = "Download for " + os;
          if (alt) alt.textContent = others[os];
        })();
      </script>

      <p class="relative mt-6 text-[17px] text-fg-2" data-reveal style="--i:6">
        Let your creativity flow. Free and open-source, forever.
      </p>

      {/* The hero is a composition, and this is its timeline: what is above is
          drawn from these keyframes, and a visitor can move them. */}
      <div class="relative mt-12 flex w-full justify-center" data-reveal style="--i:8">
        <HeroTimeline />
      </div>
    </section>
  </div>

  {/* ---------- the page below the hero, a section to a component ---------- */}
  <Showcase />
  <Workspaces />
  <Together />
  <Stories />
  <Features />
  <Roadmap />
  <Closing />

  {/* ---------- a screenshot, brought forward ---------- */}
  <dialog class="lightbox" data-lightbox aria-label="Screenshot, enlarged">
    <div class="veil" data-veil></div>
  </dialog>

  {/* What the page behind is put through while a screenshot is forward: a
      lens blur, not a Gaussian one. Each of the four stages averages two
      copies of the picture pushed apart along one direction, and four
      directions 45 degrees apart leave sixteen copies on two rings - the
      shape a point of light takes through an out-of-focus lens, where a
      Gaussian would only make a soft dot. The small blur first fills in
      between the copies. The script sets every distance once, and the blur
      is only switched on and off, since the veil over it is what fades.
      Units are CSS pixels. The two tables either side are the script's too:
      the picture is blurred through a curve that makes its bright end count
      for more, and comes back through the inverse. */}
  <svg class="lens-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="lens" color-interpolation-filters="sRGB">
      <feComponentTransfer in="SourceGraphic" result="lit">
        <feFuncR type="table" data-lens-in></feFuncR>
        <feFuncG type="table" data-lens-in></feFuncG>
        <feFuncB type="table" data-lens-in></feFuncB>
      </feComponentTransfer>
      <feGaussianBlur in="lit" stdDeviation="0" data-lens-soft result="s"></feGaussianBlur>
      <feOffset in="s" data-lens="1 0" result="a1"></feOffset>
      <feOffset in="s" data-lens="-1 0" result="a2"></feOffset>
      <feComposite in="a1" in2="a2" operator="arithmetic" k1="0" k2="0.5" k3="0.5" k4="0" result="a"></feComposite>
      <feOffset in="a" data-lens="0 1" result="b1"></feOffset>
      <feOffset in="a" data-lens="0 -1" result="b2"></feOffset>
      <feComposite in="b1" in2="b2" operator="arithmetic" k1="0" k2="0.5" k3="0.5" k4="0" result="b"></feComposite>
      <feOffset in="b" data-lens="0.7071 0.7071" result="c1"></feOffset>
      <feOffset in="b" data-lens="-0.7071 -0.7071" result="c2"></feOffset>
      <feComposite in="c1" in2="c2" operator="arithmetic" k1="0" k2="0.5" k3="0.5" k4="0" result="c"></feComposite>
      <feOffset in="c" data-lens="0.7071 -0.7071" result="d1"></feOffset>
      <feOffset in="c" data-lens="-0.7071 0.7071" result="d2"></feOffset>
      <feComposite in="d1" in2="d2" operator="arithmetic" k1="0" k2="0.5" k3="0.5" k4="0" result="d"></feComposite>
      <feComponentTransfer in="d">
        <feFuncR type="table" data-lens-out></feFuncR>
        <feFuncG type="table" data-lens-out></feFuncG>
        <feFuncB type="table" data-lens-out></feFuncB>
      </feComponentTransfer>
    </filter>
  </svg>
</Base>

<style>
  /* The download button blurs in as the page is shown, and the rest of the
     hero follows it. */
  :global(html.anim) .lead {
    animation: piece-in 500ms var(--ease-out) both;
  }
  @keyframes piece-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.anim) .lead {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  /* The screenshot brought forward. The dialog is the whole window and draws
     nothing itself: the veil dims the page and lays the hero's grain over it,
     the page behind is out of focus (the lens filter, set from the script),
     and the script puts a copy of the screenshot's panel in it and moves
     that. A dialog has a text colour of its own, which the copy must not
     take. */
  .lightbox {
    color: inherit;
    cursor: pointer;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: none;
    outline: none;
  }
  .lightbox::backdrop {
    background: none;
  }
  .veil {
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, var(--color-ink) 38%, transparent);
    background-image: var(--grain, none);
    background-size: 128px 128px;
    opacity: 0;
    transition: opacity 300ms ease-out;
  }
  .lightbox.open .veil {
    opacity: 1;
  }
  /* No `will-change` here: with it the words in the panel stay drawn at the
     size they left the page at, and are soft once it has grown. */
  .lightbox :global(.forward) {
    position: absolute;
    margin: 0;
    box-shadow: 0 30px 90px rgb(0 0 0 / 0.55);
    transform-origin: 0 0;
    user-select: none;
  }
  /* It is forward already, so its strip does not say how to get it there. */
  .lightbox :global(.forward .shot-bar > span:last-child) {
    visibility: hidden;
  }
</style>

<style is:global>
  /* The page behind a screenshot that has come forward. Global, since the bar
     and the footer are not this page's own elements. */
  html.lens body > header,
  html.lens body > main,
  html.lens body > footer {
    filter: url(#lens);
  }
  /* The page's own ground under its words while the lens is on. Without it
     they stand on nothing, and the lens can only fade them out where it
     should be weighing light against dark. */
  html.lens body > main {
    background-color: var(--color-ink);
  }
</style>

<script>
  import { hero } from "../scripts/hero-state";

  // Point the download buttons straight at the installer for the visitor's
  // platform. Pure enhancement: each ships pointing at /download, and every
  // failure here leaves it be. A button's *words* are set inline beside it
  // instead, because changing them after this module loads would move the layout.
  //
  // No platform is "coming": release.yml builds a Windows .exe, a macOS .dmg
  // and a Linux .flatpak on every tag and every job gates the release,
  // so all three exist whenever any of them does.
  const ASSET: Record<string, RegExp> = {
    Windows: /windows.*\.exe$/i,
    Linux: /linux.*\.flatpak$/i,
    macOS: /\.dmg$/i,
  };
  // The inline script in the hero has already worked the platform out.
  const os = document.documentElement.dataset.os;

  const btns = document.querySelectorAll<HTMLAnchorElement>("[data-dl]");

  type Asset = { name: string; browser_download_url: string };
  if (os && btns.length && ASSET[os]) {
    const want = ASSET[os];
    fetch("https://api.github.com/repos/luminalmvm/Lumit/releases/latest")
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json() as Promise<{ assets: Asset[] }>;
      })
      .then((rel) => {
        const asset = rel.assets.find((a) => want.test(a.name));
        if (asset) for (const btn of btns) btn.href = asset.browser_download_url;
      })
      .catch(() => {
        /* the shipped /download link stands */
      });
  }

  // Meet the interface: five windows in a stack. A click on one behind brings
  // it to the front with the rest in turn behind it, and only the front one's
  // clip plays. The front one is a screenshot like any other, so its click is
  // left to the code below.
  const stack = document.querySelector<HTMLElement>("[data-stack]");
  if (stack) {
    const layers = [...stack.querySelectorAll<HTMLButtonElement>("[data-layer]")];
    // Heard on the way down, so a window behind comes forward before the
    // click can reach it as a screenshot to enlarge.
    stack.addEventListener(
      "click",
      (e) => {
        const picked = (e.target as Element).closest<HTMLButtonElement>("[data-layer]");
        if (!picked || picked.hasAttribute("aria-current")) return;
        e.stopPropagation();
        const front = layers.indexOf(picked);
        layers.forEach((layer, i) => {
          const on = i === front;
          layer.style.setProperty("--o", String((i - front + layers.length) % layers.length));
          layer.ariaCurrent = on ? "true" : null;
          layer.ariaLabel = on ? "Enlarge this screenshot" : `Show the ${layer.dataset.name} workspace`;
          // A clip's first frame is its picture, so one sent back looks as
          // it did before it played.
          const clip = layer.querySelector("video");
          if (!clip) return;
          clip.pause();
          clip.currentTime = 0;
          const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
          if (on && !saveData && !matchMedia("(prefers-reduced-motion: reduce)").matches) clip.play().catch(() => {});
        });
      },
      true,
    );
  }

  // A screenshot comes forward where it sits on the page, panel and all, with
  // a little spring, to half as big again or what the window has room for.
  // The page behind goes out of focus and takes the hero's grain. A click
  // anywhere, Escape, or a scroll sends it back to its size.
  const box = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  if (box) {
    const root = document.documentElement;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    // Out of <main>, which is one of the things the lens filter is put on.
    document.body.append(box);

    // ---- the lens ----
    const soft = document.querySelector<SVGElement>("[data-lens-soft]")!;
    const offsets = [...document.querySelectorAll<SVGElement>("[data-lens]")].map((el) => {
      const [x, y] = el.dataset.lens!.split(" ").map(Number);
      return { el, x, y };
    });
    const REACH = 4.5; // each stage pushes its two copies this far apart, each way
    // Averaging the page's own values lets a bright point sink into the dark
    // around it, where a lens leaves it standing as a ring. So the page goes
    // through this curve first and back through its inverse after. The
    // straight part is what keeps the dark greys apart in the eight bits a
    // filter works in, which a plain gamma would not.
    const light = (x: number) => 0.5 * x + 0.5 * x ** 4;
    const unlight = (y: number) => {
      let lo = 0;
      let hi = 1;
      for (let i = 0; i < 20; i++) {
        const mid = (lo + hi) / 2;
        if (light(mid) < y) lo = mid;
        else hi = mid;
      }
      return lo;
    };
    // A filter drops the fraction when it turns a table into eight bits, and
    // twice over that darkens the page's ground. Half a step up rounds it.
    const table = (f: (x: number) => number) =>
      Array.from({ length: 65 }, (_, i) => Math.min(1, f(i / 64) + 0.5 / 255).toFixed(4)).join(" ");
    for (const el of document.querySelectorAll("[data-lens-in]")) el.setAttribute("tableValues", table(light));
    for (const el of document.querySelectorAll("[data-lens-out]")) el.setAttribute("tableValues", table(unlight));
    soft.setAttribute("stdDeviation", "2.4");
    for (const o of offsets) {
      o.el.setAttribute("dx", (o.x * REACH).toFixed(2));
      o.el.setAttribute("dy", (o.y * REACH).toFixed(2));
    }
    // The clips behind stop while a screenshot is forward.
    let stopped: HTMLVideoElement[] = [];

    // ---- the grain ----
    // The hero field's own grain (HeroField.astro, `phash`), a screen pixel at
    // a time whatever the screen, as a tile: white where it would add and
    // black where it would take away, each as faint as the amount.
    const grain = () => {
      const n = Math.round(128 * (devicePixelRatio || 1));
      const tile = document.createElement("canvas");
      tile.width = tile.height = n;
      const ctx = tile.getContext("2d");
      if (!ctx) return;
      const img = ctx.createImageData(n, n);
      const fract = (v: number) => v - Math.floor(v);
      for (let y = 0; y < n; y++) {
        for (let x = 0; x < n; x++) {
          let qx = fract(x * 0.1031);
          let qy = fract(y * 0.1031);
          let qz = qx;
          const d = qx * (qy + 33.33) + qy * (qz + 33.33) + qz * (qx + 33.33);
          qx += d;
          qy += d;
          qz += d;
          const v = (fract((qx + qy) * qz) - 0.5) * 0.036 * 1.1;
          const i = (y * n + x) * 4;
          img.data[i] = img.data[i + 1] = img.data[i + 2] = v > 0 ? 255 : 0;
          img.data[i + 3] = Math.round(Math.abs(v) * 255);
        }
      }
      ctx.putImageData(img, 0, 0);
      box.style.setProperty("--grain", `url(${tile.toDataURL()})`);
    };
    let grained = false;

    // ---- the panel ----
    // What comes forward is a copy of the screenshot's whole panel: its frame,
    // its strip and its words. The copy is laid out at the size the panel has
    // on the page and scaled up by `grow`, so its words grow with it.
    type Box = { left: number; top: number; width: number; height: number };
    let panel: HTMLElement | null = null;
    let copy: HTMLElement | null = null;
    let home: Box = { left: 0, top: 0, width: 1, height: 1 };
    let grow = 1;
    let closing = false;

    // Where a box is, said as a transform of the copy's forward place.
    const from = (r: Box, x = 1) =>
      `translate(${((r.left - home.left) * x).toFixed(2)}px, ${((r.top - home.top) * x).toFixed(2)}px) ` +
      `scale(${((1 + (r.width / home.width - 1) * x) * grow).toFixed(4)})`;
    // A spring with a little bounce in it, settled by 450ms.
    const spring = (time: number) => {
      const z = 0.85;
      const w = (2 * Math.PI) / 0.45;
      const wd = w * Math.sqrt(1 - z * z);
      return 1 - Math.exp(-z * w * time) * (Math.cos(wd * time) + ((z * w) / wd) * Math.sin(wd * time));
    };

    const open = (shot: HTMLButtonElement) => {
      const here = shot.closest<HTMLElement>(".shot");
      const small = shot.querySelector("img");
      if (!here || !small || box.open) return;
      // On a phone it would only grow a little, so the capture itself opens.
      if (innerWidth < 640) {
        location.assign(shot.dataset.zoom!);
        return;
      }
      panel = here;
      closing = false;
      if (!grained) {
        grained = true;
        grain();
      }

      // The copy is only looked at: it cannot be clicked or tabbed to, so a
      // click on it lands on the dialog, and the dialog says what it shows.
      const fwd = here.cloneNode(true) as HTMLElement;
      copy = fwd;
      fwd.classList.add("forward");
      fwd.removeAttribute("data-reveal");
      fwd.inert = true;
      box.ariaLabel = `Screenshot, enlarged: ${small.alt}`;
      // The picture stands in for its clip, as it does on the page.
      fwd.querySelector("[data-clip]")?.remove();
      // The picture the page already has, then the one at the capture's size.
      const url = shot.dataset.zoom!;
      const pic = fwd.querySelector("img")!;
      pic.removeAttribute("srcset");
      pic.removeAttribute("loading");
      pic.decoding = "sync";
      pic.src = small.currentSrc || url;
      const big = new Image();
      big.onload = () => {
        if (copy === fwd) pic.src = url;
      };
      big.src = url;

      // Forward is a step towards the visitor: half as big again as it stands
      // on the page, less where the window has not the room, and the picture
      // never bigger than the capture itself. The computed size and not the
      // box, which has the growth under the pointer in it.
      const start = here.getBoundingClientRect();
      const laid = getComputedStyle(here);
      const pw = parseFloat(laid.width);
      const ph = parseFloat(laid.height);
      const phone = innerWidth < 640;
      grow = Math.min(
        1.5,
        (innerWidth * (phone ? 0.94 : 0.8)) / pw,
        (innerHeight * 0.9) / ph,
        Number(shot.dataset.w) / small.offsetWidth,
      );
      const width = pw * grow;
      const height = ph * grow;
      // It grows where it is and does not travel: the corner furthest from
      // the middle of the window stays put, so it grows towards the middle.
      // One that sits near the middle grows evenly instead. Then it moves
      // only as far as it takes to be wholly in the window.
      const pad = phone ? 12 : 24;
      const within = (at: number, size: number, room: number) =>
        Math.max(Math.min(at, room - pad - size), Math.min(pad, (room - size) / 2));
      // How much of the growth goes to the near side: none of it out at the
      // left or top, all of it at the right or bottom, half in the middle.
      const share = (at: number, size: number, room: number) =>
        Math.min(1, Math.max(0, 0.5 + ((at + size / 2) / room - 0.5) * 4));
      home = {
        left: within(start.left - (width - start.width) * share(start.left, start.width, innerWidth), width, innerWidth),
        top: within(start.top - (height - start.height) * share(start.top, start.height, innerHeight), height, innerHeight),
        width,
        height,
      };
      fwd.style.left = `${home.left}px`;
      fwd.style.top = `${home.top}px`;
      fwd.style.width = `${pw}px`;
      fwd.style.height = `${ph}px`;
      fwd.style.transform = from(home);
      box.append(fwd);

      box.showModal();
      box.classList.add("open");
      here.style.visibility = "hidden";
      hero.paused = true;
      root.classList.add("lens");
      stopped = [...document.querySelectorAll<HTMLVideoElement>("[data-clip]")].filter((v) => !v.paused);
      for (const v of stopped) v.pause();

      // Without motion it fades in where it ends up.
      if (still) {
        fwd.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 200, easing: "ease-out" });
      } else {
        const frames: Keyframe[] = [];
        const STEPS = 30;
        for (let i = 0; i <= STEPS; i++) {
          frames.push({ transform: from(start, 1 - spring((i / STEPS) * 0.45)) });
        }
        frames[STEPS] = { transform: from(home) };
        fwd.animate(frames, { duration: 450, easing: "linear" });
      }
      addEventListener("scroll", close, { passive: true, once: true });
      addEventListener("resize", close, { once: true });
    };

    function close() {
      const fwd = copy;
      const here = panel;
      if (!box!.open || closing || !fwd || !here) return;
      closing = true;
      removeEventListener("scroll", close);
      removeEventListener("resize", close);
      // From wherever it has got to, back to where the page has it now.
      const now = fwd.getBoundingClientRect();
      fwd.getAnimations().forEach((a) => a.cancel());
      const back = here.getBoundingClientRect();
      box!.classList.remove("open");
      const going = still
        ? fwd.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 150, easing: "ease-out", fill: "forwards" })
        : fwd.animate([{ transform: from(now) }, { transform: from(back) }], {
            duration: 340,
            easing: "cubic-bezier(0.23, 1, 0.32, 1)", // --ease-out
            fill: "forwards",
          });
      going.onfinish = () => {
        here.style.visibility = "";
        box!.close();
        fwd.remove();
        copy = null;
        root.classList.remove("lens");
        for (const v of stopped) v.play().catch(() => {});
        stopped = [];
        hero.paused = false;
        closing = false;
      };
    }

    for (const shot of document.querySelectorAll<HTMLButtonElement>("[data-zoom]")) {
      shot.addEventListener("click", () => open(shot));
    }
    box.addEventListener("click", close);
    // Escape closes a dialog at once, and this one has a way back to take.
    box.addEventListener("cancel", (e) => {
      e.preventDefault();
      close();
    });
  }

  // The page arrives a group at a time as it scrolls into view, starting as
  // soon as it is read.
  const seen = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add("shown");
        seen.unobserve(entry.target);
      }
    },
    { rootMargin: "0px 0px -8% 0px" },
  );
  for (const el of document.querySelectorAll("[data-reveal]")) seen.observe(el);
</script>
